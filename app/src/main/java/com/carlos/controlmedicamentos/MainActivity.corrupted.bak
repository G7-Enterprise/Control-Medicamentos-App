    disabledContainerColor = Color.Transparent,
    cursorColor = Color(0xFFB9F4FF),
    focusedBorderColor = Color(0xFF93E6FF),
    unfocusedBorderColor = Color.White.copy(alpha = 0.30f),
    disabledBorderColor = Color.White.copy(alpha = 0.16f),
    focusedLabelColor = Color(0xFFADEBFF),
    unfocusedLabelColor = Color(0xFFD6ECFF),
    disabledLabelColor = Color(0xFF9AB2C5),
    focusedTrailingIconColor = Color(0xFFADEBFF),
    unfocusedTrailingIconColor = Color(0xFFD6ECFF),
    disabledTrailingIconColor = Color(0xFF9AB2C5),
    focusedPlaceholderColor = Color(0xFFD6ECFF),
    unfocusedPlaceholderColor = Color(0xFFBFD5E8)
)

@Composable
private fun metallicBlueButtonColors() = ButtonDefaults.buttonColors(
    containerColor = Color(0xFF0B4E96),
    contentColor = Color.White,
    disabledContainerColor = Color(0xFF375A7D),
