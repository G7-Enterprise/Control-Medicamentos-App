    var expandedCiclo by remember { mutableStateOf(false) }
    var expandedToma by remember { mutableStateOf(false) }
    var expandedPesoUnidad by remember { mutableStateOf(false) }
    var expandedEstaturaUnidad by remember { mutableStateOf(false) }
    var expandedFrecuenciaBackup by remember { mutableStateOf(false) }
    var expandedReintentoCritico by remember { mutableStateOf(false) }
    var expandedNumeroRepeticionesCritico by remember { mutableStateOf(false) }
    var expandedRecordatorioCita by remember { mutableStateOf(false) }

    var formatoSeleccionado by remember { mutableStateOf("") }
    var presentacionPersistida by remember { mutableStateOf("") }
    var concentracionSeleccionada by remember { mutableStateOf("") }
    var cicloSeleccionado by remember { mutableStateOf("Diario") }
    var tomaSeleccionada by remember { mutableStateOf("En una sola toma") }
    val horasTomas = remember { mutableStateListOf<String>() }

    val context = LocalContext.current
    val lifecycleOwner = LocalLifecycleOwner.current
    val coroutineScope = rememberCoroutineScope()
    val aiConfigInicial = remember(context) { MedicalAiSettings.load(context) }
    var urlServicioIa by remember(context) { mutableStateOf(aiConfigInicial.endpointUrl) }
    var modeloServicioIa by remember(context) { mutableStateOf(aiConfigInicial.modelName) }
    var alarmaSonidoUri by remember(context) { mutableStateOf(CriticalAlertSettings.getSoundUri(context)) }
    var alarmaSonidoNombre by remember(context) {
        mutableStateOf(resolveAlarmSoundLabel(context, CriticalAlertSettings.getSoundUri(context)))
    }
    var intervaloReintentoSeleccionado by remember(context) {
        mutableStateOf(CriticalAlertSettings.getRetryIntervalMinutes(context))
    }
    var numeroRepeticionesCriticoSeleccionado by remember(context) {
        mutableStateOf(CriticalAlertSettings.getMaxRetryCount(context))
    }
    val database = remember(context) { AppDatabase.getDatabase(context) }
    val perfilesPacientes by database.patientProfileDao().observarTodos().collectAsState(initial = emptyList())
    val pacienteActivo by database.patientProfileDao().observarPerfilActivo().collectAsState(initial = null)
    val medicamentosGuardados by remember(pacienteActivo?.id) {
        if (pacienteActivo == null) {
            flowOf(emptyList())
        } else {
            database.medicationDao().obtenerActivosPorPaciente(pacienteActivo!!.id)
        }
    }.collectAsState(initial = emptyList())
    val reportesMedicos by remember(pacienteActivo?.id) {
        if (pacienteActivo == null) {
            flowOf(emptyList())
        } else {
            database.medicalReportDao().observarPorPaciente(pacienteActivo!!.id)
        }
    }.collectAsState(initial = emptyList())
    val citasMedicas by remember(pacienteActivo?.id) {
        if (pacienteActivo == null) {
            flowOf(emptyList())
        } else {
            database.medicalAppointmentDao().observarPorPaciente(pacienteActivo!!.id)
        }
    }.collectAsState(initial = emptyList())
    val signosVitales by database.signosVitalesDao().obtenerTodos().collectAsState(initial = emptyList())
    val sugerencias = remember(nombre) { FakeVademecumRepository.buscarPorNombre(nombre) }
    val opcionesToma = listOf("En una sola toma", "En diferentes horarios")
    val ciclos = listOf("Diario", "Semanal", "Mensual", "Cada 8 horas", "Cada 12 horas", "Personalizado")
    val opcionesPesoUnidad = listOf("kg", "lb")
    val opcionesEstaturaUnidad = listOf("cm", "in")
    val opcionesFrecuenciaBackup = listOf("Solo manual", "Diario", "Semanal")
    val opcionesReintentoCritico = listOf(5, 10, 15)
    val opcionesNumeroRepeticionesCritico = (0..CriticalAlertSettings.MAX_ALLOWED_RETRY_COUNT).map(Int::toString)
    val opcionesRecordatorioCita = listOf(15, 30, 60, 120, 1440)
    var fechaEscritorioSeleccionada by remember { mutableStateOf(inicioDelDia(System.currentTimeMillis())) }
    var direccionAnimacionEscritorio by remember { mutableStateOf(1) }
    var frecuenciaBackupSeleccionada by remember { mutableStateOf(AutoBackupScheduler.getFrequency(context)) }
    var refrescoBackup by remember { mutableStateOf(0) }
    var exportandoTomas by remember { mutableStateOf(false) }
    var periodoExportacionPendiente by remember { mutableStateOf<IntakeExportPeriod?>(null) }
    var expandedFiltroExportacionSignos by remember { mutableStateOf(false) }
    var filtroExportacionSignos by remember { mutableStateOf(VitalSignsExportFilter.TODAY) }
    var fechaInicioExportacionSignos by remember { mutableStateOf(inicioDelDia(System.currentTimeMillis())) }
    var fechaFinExportacionSignos by remember { mutableStateOf(finDelDia(System.currentTimeMillis())) }
    var exportandoSignosVitales by remember { mutableStateOf(false) }
    var exportacionSignosPendiente by remember { mutableStateOf<VitalSignsExportRequest?>(null) }
    var mostrarListadoSignosGuardados by remember { mutableStateOf(false) }
    var mostrarVistaPreviaSignosSeleccionados by remember { mutableStateOf(false) }
    val registrosSignosSeleccionados = remember { mutableStateListOf<Int>() }
    val signosVitalesSeleccionados = signosVitales
        .filter { registrosSignosSeleccionados.contains(it.id) }
        .sortedBy { it.fechaRegistro }
    val fechaActualTexto = remember(fechaEscritorioSeleccionada) { formatDashboardDate(fechaEscritorioSeleccionada) }
    val fechaResumenEscritorioTexto = remember(fechaEscritorioSeleccionada) { formatDashboardDateSummary(fechaEscritorioSeleccionada) }
    val diasCarruselEscritorio = remember(fechaEscritorioSeleccionada) { obtenerCarruselEscritorio(fechaEscritorioSeleccionada) }
    val inicioFechaSeleccionada = remember(fechaEscritorioSeleccionada) { inicioDelDia(fechaEscritorioSeleccionada) }
    val finFechaSeleccionada = remember(fechaEscritorioSeleccionada) { finDelDia(fechaEscritorioSeleccionada) }
    val tomasRegistradasDelDia by database.medicationIntakeDao()
        .observarEnRango(inicioFechaSeleccionada, finFechaSeleccionada)
        .collectAsState(initial = emptyList())
    val tomasRegistradasLookup = remember(tomasRegistradasDelDia) {
        tomasRegistradasDelDia.associateBy { it.medicationId to it.scheduledAt }
    }
    val medicamentosProgramadosDelDia = remember(medicamentosGuardados, fechaEscritorioSeleccionada) {
        obtenerMedicamentosProgramadosDelDia(medicamentosGuardados, fechaEscritorioSeleccionada)
    }
    val fechaNacimientoTexto = remember(fechaNacimientoPaciente) {
        fechaNacimientoPaciente?.let { formatDate(it) }.orEmpty()
    }
    val edadCalculadaPaciente = remember(fechaNacimientoPaciente) {
        fechaNacimientoPaciente?.let { calcularEdadDesdeNacimiento(it).toString() }.orEmpty()
    }
    val ultimoBackupAutomatico = remember(refrescoBackup) {
        BackupManager.latestAutomaticBackupFile(context)
    }
    fun cambiarFechaEscritorio(nuevaFecha: Long) {
        val fechaNormalizada = inicioDelDia(nuevaFecha)
        val fechaActual = inicioDelDia(fechaEscritorioSeleccionada)
        if (fechaNormalizada == fechaActual) return
        direccionAnimacionEscritorio = if (fechaNormalizada > fechaActual) 1 else -1
        fechaEscritorioSeleccionada = fechaNormalizada
    }

    var tienePermisoNotificaciones by remember { mutableStateOf(notificationPermissionGranted(context)) }
    var tienePermisoAlarmaExacta by remember { mutableStateOf(exactAlarmPermissionGranted(context)) }
    var tienePermisoCamara by remember { mutableStateOf(cameraPermissionGranted(context)) }
    var tieneAccesoNoMolestar by remember { mutableStateOf(notificationPolicyAccessGranted(context)) }
    val notificationPermissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { granted ->
        tienePermisoNotificaciones = granted || notificationPermissionGranted(context)
    }
    val exactAlarmPermissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.StartActivityForResult()
    ) {
        tienePermisoAlarmaExacta = exactAlarmPermissionGranted(context)
    }
    val notificationPolicyAccessLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.StartActivityForResult()
    ) {
        tieneAccesoNoMolestar = notificationPolicyAccessGranted(context)
    }
    val pickStudyImagesLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetMultipleContents()
    ) { uris ->
        uris.forEach { uri ->
            copyUriToInternalStorage(context, uri)?.let { estudiosAdjuntos.add(it) }
        }
    }
    val takeStudyPictureLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.TakePicturePreview()
    ) { bitmap ->
        bitmap?.let {
            saveBitmapToInternalStorage(context, it)?.let { savedUri ->
                estudiosAdjuntos.add(savedUri)
            }
        }
    }
    val cameraPermissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { granted ->
        tienePermisoCamara = granted || cameraPermissionGranted(context)
        if (granted && cameraPermissionPending) {
            cameraPermissionPending = false
            takeStudyPictureLauncher.launch(null)
        } else {
            cameraPermissionPending = false
        }
    }
    val createBackupDocumentLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.CreateDocument("application/json")
    ) { uri ->
        if (uri == null) {
            ejecutandoBackupManual = false
            return@rememberLauncherForActivityResult
        }
        coroutineScope.launch(Dispatchers.IO) {
            try {
                val summary = BackupManager.exportManualBackup(context, uri)
                withContext(Dispatchers.Main) {
                    ejecutandoBackupManual = false
                    refrescoBackup += 1
                    mensajeBackup = "Backup manual creado: ${summary.medications} medicamentos, ${summary.patients} pacientes"
                    Toast.makeText(context, mensajeBackup, Toast.LENGTH_LONG).show()
                }
            } catch (exception: Exception) {
                withContext(Dispatchers.Main) {
                    ejecutandoBackupManual = false
                    mensajeBackup = "No se pudo crear el backup: ${exception.message ?: "error desconocido"}"
                    Toast.makeText(context, mensajeBackup, Toast.LENGTH_LONG).show()
                }
            }
        }
    }
    val restoreBackupDocumentLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri == null) {
            restaurandoBackup = false
            return@rememberLauncherForActivityResult
        }
        coroutineScope.launch(Dispatchers.IO) {
            try {
                val summary = BackupManager.importManualBackup(context, uri)
                withContext(Dispatchers.Main) {
                    restaurandoBackup = false
                    refrescoBackup += 1
                    mensajeBackup = "Backup restaurado: ${summary.medications} medicamentos, ${summary.patients} pacientes"
                    val restoredConfig = CriticalAlertSettings.load(context)
                    intervaloReintentoSeleccionado = restoredConfig.retryIntervalMinutes
                    numeroRepeticionesCriticoSeleccionado = restoredConfig.maxRetryCount
                    alarmaSonidoUri = restoredConfig.soundUri
                    alarmaSonidoNombre = resolveAlarmSoundLabel(context, restoredConfig.soundUri)
                    mostrarFichaPaciente = false
                    mostrarFormularioInforme = false
                    mostrarPanelPacientes = false
                    mostrarPanelInformes = false
                    mostrarListaMedicamentos = false
                    mostrarPanelBackups = false
                    mostrarPanelConfiguracionAlertas = false
                    mostrarPanelSignosVitales = false
                    mostrarPanelConfiguracionIa = false
                    mostrarFormulario = false
                    Toast.makeText(context, mensajeBackup, Toast.LENGTH_LONG).show()
                }
            } catch (exception: Exception) {
                withContext(Dispatchers.Main) {
                    restaurandoBackup = false
                    mensajeBackup = "No se pudo restaurar el backup: ${exception.message ?: "error desconocido"}"
                    Toast.makeText(context, mensajeBackup, Toast.LENGTH_LONG).show()
                }
            }
        }
    }
    val exportMedicationReportLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.CreateDocument("application/rtf")
    ) { uri ->
        val periodo = periodoExportacionPendiente
        val paciente = pacienteActivo
        if (uri == null || periodo == null || paciente == null) {
            exportandoTomas = false
            periodoExportacionPendiente = null
            return@rememberLauncherForActivityResult
        }

        coroutineScope.launch(Dispatchers.IO) {
            try {
                val rango = calcularRangoExportacion(periodo, fechaEscritorioSeleccionada)
                val medications = database.medicationDao().obtenerTodosPorPacienteLista(paciente.id)
                val intakes = database.medicationIntakeDao().obtenerEnRango(rango.start, rango.end)
                val payload = buildMedicationIntakeRtfDocument(
                    patient = paciente,
                    medications = medications,
                    intakes = intakes,
                    range = rango
                )

                context.contentResolver.openOutputStream(uri)?.use { output ->
                    output.write(payload.toByteArray(Charsets.UTF_8))
                } ?: error("No se pudo abrir el archivo de destino")

                withContext(Dispatchers.Main) {
                    exportandoTomas = false
                    periodoExportacionPendiente = null
                    Toast.makeText(context, "Informe de tomas exportado correctamente en formato Word compatible", Toast.LENGTH_LONG).show()
                }
            } catch (exception: Exception) {
                withContext(Dispatchers.Main) {
                    exportandoTomas = false
                    periodoExportacionPendiente = null
                    Toast.makeText(
                        context,
                        "No se pudo exportar el informe: ${exception.message ?: "error desconocido"}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        }
    }
    val exportVitalSignsReportLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.CreateDocument("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
    ) { uri ->
        val request = exportacionSignosPendiente
        if (uri == null || request == null) {
            exportandoSignosVitales = false
            exportacionSignosPendiente = null
            return@rememberLauncherForActivityResult
        }

        coroutineScope.launch(Dispatchers.IO) {
            try {
                context.contentResolver.openOutputStream(uri)?.use { output ->
                    writeVitalSignsDocxDocument(
                        output = output,
                        report = buildVitalSignsExportReport(
                            records = request.records,
                            patient = pacienteActivo,
                            rangeLabel = request.label
                        )
                    )
                } ?: error("No se pudo abrir el archivo de destino")

                withContext(Dispatchers.Main) {
                    exportandoSignosVitales = false
                    exportacionSignosPendiente = null
                    Toast.makeText(context, "Reporte de signos vitales exportado en formato Word", Toast.LENGTH_LONG).show()
                }
            } catch (exception: Exception) {
                withContext(Dispatchers.Main) {
                    exportandoSignosVitales = false
                    exportacionSignosPendiente = null
                    Toast.makeText(
                        context,
                        "No se pudo exportar el reporte: ${exception.message ?: "error desconocido"}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        }
    }
    val ringtonePickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.StartActivityForResult()
    ) { result ->
        if (result.resultCode != Activity.RESULT_OK) {
            return@rememberLauncherForActivityResult
        }

        val pickedUri = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            result.data?.getParcelableExtra(RingtoneManager.EXTRA_RINGTONE_PICKED_URI, Uri::class.java)
        } else {
            @Suppress("DEPRECATION")
            result.data?.getParcelableExtra(RingtoneManager.EXTRA_RINGTONE_PICKED_URI)
        }

        if (pickedUri == null) {
            alarmaSonidoUri = ""
            alarmaSonidoNombre = "Alarma predeterminada"
        } else {
            alarmaSonidoUri = pickedUri.toString()
            alarmaSonidoNombre = resolveRingtoneTitle(context, pickedUri)
        }
    }

    DisposableEffect(lifecycleOwner, context) {
        val observer = LifecycleEventObserver { _, event ->
            if (event == Lifecycle.Event.ON_RESUME) {
                tienePermisoNotificaciones = notificationPermissionGranted(context)
                tienePermisoAlarmaExacta = exactAlarmPermissionGranted(context)
                tienePermisoCamara = cameraPermissionGranted(context)
                tieneAccesoNoMolestar = notificationPolicyAccessGranted(context)
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose {
            lifecycleOwner.lifecycle.removeObserver(observer)
        }
    }

    fun resetForm() {
        nombre = ""
        cantidad = ""
        selectedMedication = null
        formatoSeleccionado = ""
        presentacionPersistida = ""
        concentracionSeleccionada = ""
        cicloSeleccionado = "Diario"
        tomaSeleccionada = "En una sola toma"
        horasTomas.clear()
        fechaInicio = System.currentTimeMillis()
        fechaFin = System.currentTimeMillis()
        horaTomaSeleccionada = ""
        alarmaActiva = true
        esCicloCorto = false
        estaActivo = true
        controlarExistencias = false
        stockActualInput = ""
        stockMinimoInput = ""
        mostrarDialogoConcentracionPersonalizada = false
        concentracionPersonalizadaInput = ""
        editingMedicationId = null
    }

    fun cerrarPanelesSecundarios() {
        mostrarFichaPaciente = false
        mostrarFormularioInforme = false
        mostrarPanelPacientes = false
        mostrarPanelCitasMedicas = false
        mostrarPanelInformes = false
        mostrarListaMedicamentos = false
        mostrarPanelBackups = false
        mostrarPanelConfiguracionAlertas = false
        mostrarPanelSignosVitales = false
        mostrarPanelConfiguracionIa = false
        mostrarFormulario = false
    }

    fun guardarConfiguracionAlertasCriticas() {
        val config = CriticalAlertConfig(
            retryIntervalMinutes = intervaloReintentoSeleccionado,
            maxRetryCount = numeroRepeticionesCriticoSeleccionado,
            soundUri = alarmaSonidoUri
        )
        CriticalAlertSettings.save(context, config)
        alarmaSonidoNombre = resolveAlarmSoundLabel(context, alarmaSonidoUri)
    }

    fun guardarConfiguracionIa() {
        MedicalAiSettings.save(
            context,
            MedicalAiConfig(
                endpointUrl = urlServicioIa,
                modelName = modeloServicioIa
            )
        )
    }

    fun resetFichaPaciente() {
        editingPatientId = null
        editandoFichaPaciente = true
        nombrePaciente = ""
        apellidosPaciente = ""
        fechaNacimientoPaciente = null
        edadPaciente = ""
        pesoPaciente = ""
        pesoUnidadPaciente = "kg"
        estaturaPaciente = ""
        estaturaUnidadPaciente = "cm"
        enfermedadesPaciente = ""
        prescripcionesPaciente = ""
        ultimoAnalisisPaciente = ""
    }

    fun resetCitaMedica() {
        editingAppointmentId = null
        tituloCitaMedica = ""
        profesionalCitaMedica = ""
        lugarCitaMedica = ""
        notasCitaMedica = ""
        fechaCitaMedica = siguienteHoraDisponible()
        recordatorioCitaMinutos = 60
        alarmaCitaMedicaActiva = true
        expandedRecordatorioCita = false
    }

    fun cargarCitaMedica(appointment: MedicalAppointment) {
        editingAppointmentId = appointment.id
        tituloCitaMedica = appointment.title
        profesionalCitaMedica = appointment.doctorName
        lugarCitaMedica = appointment.location
        notasCitaMedica = appointment.notes
        fechaCitaMedica = appointment.scheduledAt
        recordatorioCitaMinutos = appointment.reminderMinutes
        alarmaCitaMedicaActiva = appointment.alarmEnabled
        expandedRecordatorioCita = false
    }

    fun cargarFichaPaciente(profile: PatientProfile) {
        editingPatientId = profile.id
        nombrePaciente = profile.nombre
        apellidosPaciente = profile.apellidos
        fechaNacimientoPaciente = profile.fechaNacimiento.takeIf { it > 0L }
        edadPaciente = profile.edad
        pesoPaciente = profile.peso
        pesoUnidadPaciente = profile.pesoUnidad
        estaturaPaciente = profile.estatura
        estaturaUnidadPaciente = profile.estaturaUnidad
        enfermedadesPaciente = profile.enfermedades
        prescripcionesPaciente = profile.prescripciones
        ultimoAnalisisPaciente = profile.ultimoAnalisisIa
    }

    fun abrirFichaPaciente(profile: PatientProfile, enEdicion: Boolean = false) {
        cargarFichaPaciente(profile)
        cerrarPanelesSecundarios()
        editandoFichaPaciente = enEdicion
        mostrarFichaPaciente = true
    }

    fun abrirNuevaFichaPaciente() {
        cerrarPanelesSecundarios()
        resetFichaPaciente()
        editandoFichaPaciente = true
        mostrarFichaPaciente = true
    }

    fun cancelarFichaPaciente() {
        val profileActual = perfilesPacientes.firstOrNull { it.id == editingPatientId }
        if (profileActual != null) {
            cargarFichaPaciente(profileActual)
            editandoFichaPaciente = false
        } else {
            resetFichaPaciente()
        }
        cerrarPanelesSecundarios()
    }

    fun resetInformeMedico() {
        editingReportId = null
        tituloInforme = ""
        descripcionInforme = ""
        analisisInformeIa = ""
        estudiosAdjuntos.clear()
    }

    fun cargarInformeMedico(report: MedicalReport) {
        editingReportId = report.id
        tituloInforme = report.titulo
        descripcionInforme = report.descripcion
        analisisInformeIa = report.analisisIa
        estudiosAdjuntos.clear()
        estudiosAdjuntos.addAll(report.adjuntos.split("|").filter { it.isNotBlank() })
        mostrarFormularioInforme = true
    }

    fun cargarMedicamentoEnFormulario(medication: Medication) {
        mostrarFormulario = true
        editingMedicationId = medication.id
        nombre = medication.nombre
        cantidad = medication.dosis
        alarmaActiva = medication.alarmaActiva
        esCicloCorto = medication.esCicloCorto
        estaActivo = medication.estaActivo
        fechaInicio = medication.fechaInicio
        fechaFin = medication.fechaFin
        horaTomaSeleccionada = medication.horaToma
        formatoSeleccionado = medication.formato
        presentacionPersistida = medication.presentacion
        concentracionSeleccionada = medication.concentracion
        concentracionPersonalizadaInput = medication.concentracion
        controlarExistencias = medication.stockActual != null || medication.stockMinimo != null
        stockActualInput = medication.stockActual?.toString().orEmpty()
        stockMinimoInput = medication.stockMinimo?.toString().orEmpty()
        tomaSeleccionada = medication.repartoDosis.ifBlank { "En una sola toma" }
        horasTomas.clear()
        if (medication.horariosTomas.isNotBlank()) {
            horasTomas.addAll(medication.horariosTomas.split("|"))
        }
        cicloSeleccionado = hoursToCycle(medication.frecuenciaHoras)
        selectedMedication = FakeVademecumRepository.obtenerExacto(medication.nombre)
            ?: medicationToVademecum(medication)
    }
    val calendar = remember { Calendar.getInstance() }

    LaunchedEffect(nombre) {
        val exacto = FakeVademecumRepository.obtenerExacto(nombre)
        if (exacto != null) {
            selectedMedication = exacto
            if (formatoSeleccionado !in exacto.formatos) {
                formatoSeleccionado = exacto.formatos.firstOrNull().orEmpty()
            }
            if (presentacionPersistida.isBlank()) {
                presentacionPersistida = exacto.presentaciones.firstOrNull().orEmpty()
            }
            if (concentracionSeleccionada !in exacto.concentraciones) {
                concentracionSeleccionada = exacto.concentraciones.firstOrNull().orEmpty()
            }
        } else {
            selectedMedication = null
            formatoSeleccionado = ""
            concentracionSeleccionada = ""
        }
    }

    LaunchedEffect(cantidad, tomaSeleccionada) {
        val cantidadInt = cantidad.toIntOrNull() ?: 0
        val target = if (cantidadInt > 1 && tomaSeleccionada == "En diferentes horarios") {
            cantidadInt.coerceAtMost(5)
        } else {
            0
        }

        while (horasTomas.size < target) {
            horasTomas.add("")
        }
        while (horasTomas.size > target) {
            horasTomas.removeAt(horasTomas.lastIndex)
        }
    }

    LaunchedEffect(pacienteActivo, perfilesPacientes) {
        pacienteActivo?.let { cargarFichaPaciente(it) }
    }

    LaunchedEffect(fechaNacimientoPaciente) {
        edadPaciente = fechaNacimientoPaciente?.let { calcularEdadDesdeNacimiento(it).toString() }.orEmpty()
    }

    LaunchedEffect(pacienteActivo?.id) {
        resetCitaMedica()
    }

    LaunchedEffect(medicamentosGuardados) {
        val duplicados = medicamentosGuardados
            .groupBy { duplicateSignature(it) }
            .values
            .flatMap { grupo -> grupo.sortedBy { it.id }.drop(1) }

        if (duplicados.isNotEmpty()) {
            withContext(Dispatchers.IO) {
                duplicados.forEach { medication ->
                    database.medicationDao().eliminar(medication)
                    MedicationScheduler(context).cancelarAlarma(medication.id)
                }
            }
            Toast.makeText(
                context,
                "Se eliminaron ${duplicados.size} medicamentos duplicados",
                Toast.LENGTH_SHORT
            ).show()
        }
    }

    val mostrarEscritorio = !mostrarFormulario && !mostrarListaMedicamentos && !mostrarPanelPacientes && !mostrarPanelCitasMedicas && !mostrarFichaPaciente && !mostrarPanelInformes && !mostrarFormularioInforme && !mostrarPanelBackups && !mostrarPanelConfiguracionAlertas && !mostrarPanelSignosVitales && !mostrarPanelConfiguracionIa
    val scrollState = rememberScrollState()

    Column(
        modifier = modifier
            .fillMaxSize()
            .pointerInput(fechaEscritorioSeleccionada, mostrarEscritorio) {
                if (!mostrarEscritorio) return@pointerInput
                var totalDrag = 0f
                detectHorizontalDragGestures(
                    onHorizontalDrag = { _, dragAmount ->
                        totalDrag += dragAmount
                    },
                    onDragEnd = {
                        when {
                                totalDrag >= 96f -> cambiarFechaEscritorio(moverFecha(fechaEscritorioSeleccionada, -1))
                                totalDrag <= -96f -> cambiarFechaEscritorio(moverFecha(fechaEscritorioSeleccionada, 1))
                        }
                        totalDrag = 0f
                    },
                    onDragCancel = {
                        totalDrag = 0f
                    }
                )
            }
            .drawWithCache {
                val baseGradient = Brush.horizontalGradient(
                    colors = listOf(
                        Color(0xFF06174B),
                        Color(0xFF0D4FA8),
                        Color(0xFF1AA3F5),
                        Color(0xFF0C4AA2),
                        Color(0xFF040F32)
                    )
                )
                val topShade = Brush.verticalGradient(
                    colors = listOf(
                        Color.Black.copy(alpha = 0.22f),
                        Color.Transparent,
                        Color.Black.copy(alpha = 0.30f)
                    )
                )
                val strongLineColor = Color.White.copy(alpha = 0.11f)
                val softLineColor = Color(0xFF78C8FF).copy(alpha = 0.08f)
                val thinStroke = 1.dp.toPx()
                val softStroke = 0.6.dp.toPx()
                val spacing = 6.dp.toPx()
                val secondarySpacing = 3.dp.toPx()

                onDrawBehind {
                    if (
                        mostrarEscritorio ||
                        mostrarFormulario ||
                        mostrarListaMedicamentos ||
                        mostrarPanelPacientes ||
                        mostrarPanelCitasMedicas ||
                        mostrarFichaPaciente ||
                        mostrarFormularioInforme
                    ) {
                        drawRect(brush = baseGradient)
                        var y = 0f
                        var index = 0
                        while (y < size.height) {
                            drawLine(
                                color = if (index % 3 == 0) strongLineColor else softLineColor,
                                start = Offset(0f, y),
                                end = Offset(size.width, y),
                                strokeWidth = if (index % 3 == 0) thinStroke else softStroke
                            )
                            if (index % 5 == 0) {
                                drawLine(
                                    color = Color.Black.copy(alpha = 0.06f),
                                    start = Offset(size.width * 0.08f, y + secondarySpacing),
                                    end = Offset(size.width * 0.92f, y + secondarySpacing),
                                    strokeWidth = softStroke
                                )
                            }
                            y += spacing
                            index += 1
                        }

                        drawRect(brush = topShade)
                    } else if (mostrarPanelConfiguracionAlertas) {
                        drawRect(color = Color.Black)
                    }
                }
            }
            .padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        if (mostrarFichaPaciente) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelPacientes) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelCitasMedicas) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelInformes) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarFormularioInforme) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarListaMedicamentos) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelBackups) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelConfiguracionAlertas) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelSignosVitales) BackHandler { cerrarPanelesSecundarios() }
        if (mostrarPanelConfiguracionIa) BackHandler { cerrarPanelesSecundarios() }
            if (mostrarEscritorio) {
                MetallicGreenHeaderCard(modifier = Modifier.fillMaxWidth()) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        if (pacienteActivo != null) {
                            MetallicProfileCard(
                                modifier = Modifier
                                    .weight(1f),
                                onClick = { abrirFichaPaciente(pacienteActivo!!, enEdicion = false) }
                            ) {
                                Row(
                                    verticalAlignment = Alignment.CenterVertically,
                                    horizontalArrangement = Arrangement.spacedBy(10.dp)
                                ) {
                                    Icon(Icons.Default.AccountCircle, contentDescription = null, tint = Color(0xFFD6FFE1))
                                    Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
                                        Text("Perfil", color = Color(0xFFC9FFD9), fontWeight = FontWeight.Medium)
                                        Text("${pacienteActivo?.nombre.orEmpty()} ${pacienteActivo?.apellidos.orEmpty()}")
                                    }
                                }
                            }
                            Spacer(modifier = Modifier.width(12.dp))
                        } else {
                            Spacer(modifier = Modifier.weight(1f))
                        }
                        Column(horizontalAlignment = Alignment.End) {
                            IconButton(onClick = { mostrarMenuHamburguesa = true }) {
                                Icon(
                                    imageVector = Icons.Default.Menu,
                                    contentDescription = "Menu principal"
                                )
                            }
                            val menuShape = RoundedCornerShape(24.dp)
                            val menuItemColors = MenuDefaults.itemColors(
                                textColor = Color(0xFFF3FBFF),
                                leadingIconColor = Color(0xFFAEEBFF),
                                disabledTextColor = Color(0x88F3FBFF),
                                disabledLeadingIconColor = Color(0x66AEEBFF)
                            )
                            DropdownMenu(
                                expanded = mostrarMenuHamburguesa,
                                onDismissRequest = { mostrarMenuHamburguesa = false },
                                scrollState = rememberScrollState(),
                                shape = menuShape,
                                containerColor = Color.Transparent,
                                tonalElevation = 0.dp,
                                shadowElevation = 14.dp,
                                border = BorderStroke(1.dp, Color(0xFF84DEFF).copy(alpha = 0.42f)),
                                modifier = Modifier
                                    .heightIn(max = 360.dp)
                                    .clip(menuShape)
                                    .drawWithCache {
                                        val baseGradient = Brush.horizontalGradient(
                                            colors = listOf(
                                                Color(0xFF041B4F),
                                                Color(0xFF0B4FA2),
                                                Color(0xFF29B7FF),
                                                Color(0xFF0B4A98),
                                                Color(0xFF041334)
                                            )
                                        )
                                        val sheenGradient = Brush.horizontalGradient(
                                            colors = listOf(
                                                Color.Transparent,
                                                Color.White.copy(alpha = 0.08f),
                                                Color(0xFF9AEAFF).copy(alpha = 0.20f),
                                                Color.Transparent
                                            )
                                        )
                                        val overlayGradient = Brush.verticalGradient(
                                            colors = listOf(
                                                Color.White.copy(alpha = 0.05f),
                                                Color.Transparent,
                                                Color.Black.copy(alpha = 0.24f)
                                            )
                                        )
                                        val lineColor = Color.White.copy(alpha = 0.07f)
                                        val lineSpacing = 6.dp.toPx()
                                        val stroke = 0.7.dp.toPx()

                                        onDrawBehind {
                                            drawRect(baseGradient)
                                            drawRect(sheenGradient)
                                            var y = 0f
                                            while (y < size.height) {
                                                drawLine(
                                                    color = lineColor,
                                                    start = Offset(0f, y),
                                                    end = Offset(size.width, y),
                                                    strokeWidth = stroke
                                                )
                                                y += lineSpacing
                                            }
                                            drawRect(overlayGradient)
                                        }
                                    }
                            ) {
                                DropdownMenuItem(
                                    text = { Text("Formulario medicamento") },
                                    leadingIcon = { Icon(Icons.Default.Medication, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        if (pacienteActivo == null) {
                                            abrirNuevaFichaPaciente()
                                            Toast.makeText(context, "Crea o selecciona primero un paciente", Toast.LENGTH_SHORT).show()
                                            return@DropdownMenuItem
                                        }
                                        cerrarPanelesSecundarios()
                                        resetForm()
                                        mostrarFormulario = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Pacientes") },
                                    leadingIcon = { Icon(Icons.Default.AccountCircle, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        mostrarPanelPacientes = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Citas medicas") },
                                    leadingIcon = { Icon(Icons.Default.LocalHospital, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        mostrarPanelCitasMedicas = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Nuevo usuario") },
                                    leadingIcon = { Icon(Icons.Default.PersonAdd, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        abrirNuevaFichaPaciente()
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Informes medicos") },
                                    leadingIcon = { Icon(Icons.Default.Description, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        if (pacienteActivo == null) {
                                            abrirNuevaFichaPaciente()
                                            Toast.makeText(context, "Crea o selecciona primero un paciente", Toast.LENGTH_SHORT).show()
                                            return@DropdownMenuItem
                                        }
                                        cerrarPanelesSecundarios()
                                        mostrarPanelInformes = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Medicamentos guardados") },
                                    leadingIcon = { Icon(Icons.Default.Medication, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        if (pacienteActivo == null) {
                                            abrirNuevaFichaPaciente()
                                            Toast.makeText(context, "Crea o selecciona primero un paciente", Toast.LENGTH_SHORT).show()
                                            return@DropdownMenuItem
                                        }
                                        cerrarPanelesSecundarios()
                                        mostrarListaMedicamentos = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Fotografiar estudio") },
                                    leadingIcon = { Icon(Icons.Default.CameraAlt, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        if (pacienteActivo == null) {
                                            abrirNuevaFichaPaciente()
                                            Toast.makeText(context, "Crea o selecciona primero un paciente", Toast.LENGTH_SHORT).show()
                                            return@DropdownMenuItem
                                        }
                                        cerrarPanelesSecundarios()
                                        mostrarPanelInformes = true
                                        mostrarFormularioInforme = true
                                        if (tienePermisoCamara) {
                                            takeStudyPictureLauncher.launch(null)
                                        } else {
                                            cameraPermissionPending = true
                                            cameraPermissionLauncher.launch(Manifest.permission.CAMERA)
                                        }
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Galeria o captura") },
                                    leadingIcon = { Icon(Icons.Default.PhotoLibrary, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        if (pacienteActivo == null) {
                                            abrirNuevaFichaPaciente()
                                            Toast.makeText(context, "Crea o selecciona primero un paciente", Toast.LENGTH_SHORT).show()
                                            return@DropdownMenuItem
                                        }
                                        cerrarPanelesSecundarios()
                                        mostrarPanelInformes = true
                                        mostrarFormularioInforme = true
                                        pickStudyImagesLauncher.launch("image/*")
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Signos vitales") },
                                    leadingIcon = { Icon(Icons.Default.LocalHospital, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        sistolicaInput = ""
                                        diastolicaInput = ""
                                        comentarioPresionInput = ""
                                        latidosInput = ""
                                        comentarioLatidosInput = ""
                                        glucemiaInput = ""
                                        comentarioGlucemiaInput = ""
                                        temperaturaInput = ""
                                        comentarioTemperaturaInput = ""
                                        filtroExportacionSignos = VitalSignsExportFilter.TODAY
                                        fechaInicioExportacionSignos = inicioDelDia(System.currentTimeMillis())
                                        fechaFinExportacionSignos = finDelDia(System.currentTimeMillis())
                                        registrosSignosSeleccionados.clear()
                                        mostrarListadoSignosGuardados = false
                                        mostrarPanelSignosVitales = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Configuracion de alertas") },
                                    leadingIcon = { Icon(Icons.Default.LocalHospital, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        val currentConfig = CriticalAlertSettings.load(context)
                                        intervaloReintentoSeleccionado = currentConfig.retryIntervalMinutes
                                        numeroRepeticionesCriticoSeleccionado = currentConfig.maxRetryCount
                                        alarmaSonidoUri = currentConfig.soundUri
                                        alarmaSonidoNombre = resolveAlarmSoundLabel(context, currentConfig.soundUri)
                                        mostrarPanelConfiguracionAlertas = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Configuracion IA") },
                                    leadingIcon = { Icon(Icons.Default.Description, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        val config = MedicalAiSettings.load(context)
                                        urlServicioIa = config.endpointUrl
                                        modeloServicioIa = config.modelName
                                        mostrarPanelConfiguracionIa = true
                                    }
                                )
                                DropdownMenuItem(
                                    text = { Text("Copias de seguridad") },
                                    leadingIcon = { Icon(Icons.Default.Save, contentDescription = null) },
                                    colors = menuItemColors,
                                    onClick = {
                                        mostrarMenuHamburguesa = false
                                        cerrarPanelesSecundarios()
                                        mostrarPanelBackups = true
                                    }
                                )
                            }
                        }
                    }
                    DashboardWeekSelector(
                        selectedDate = fechaEscritorioSeleccionada,
                        weekDays = diasCarruselEscritorio,
                        onSelectDate = { cambiarFechaEscritorio(it) },
                        onPreviousWeek = {
                            cambiarFechaEscritorio(moverFecha(fechaEscritorioSeleccionada, -7))
                        },
                        onNextWeek = {
                            cambiarFechaEscritorio(moverFecha(fechaEscritorioSeleccionada, 7))
                        }
                    )
                    Text(
                        text = fechaResumenEscritorioTexto,
                        color = Color(0xFF5CC7FF),
                        fontWeight = FontWeight.Medium
                    )
                    if (medicamentosGuardados.isEmpty()) {
                        Text("Aun no hay medicamentos en la base de datos.")
                    }
            }
        }

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f, fill = false)
                .verticalScroll(scrollState),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            if (mostrarEscritorio) {
                AnimatedContent(
                    targetState = fechaEscritorioSeleccionada,
                    transitionSpec = {
                        val offsetMultiplier = if (direccionAnimacionEscritorio >= 0) 1 else -1
                        (slideInHorizontally(animationSpec = tween(240)) { width -> width * offsetMultiplier } + fadeIn(animationSpec = tween(220))) togetherWith
                            (slideOutHorizontally(animationSpec = tween(240)) { width -> -width * offsetMultiplier } + fadeOut(animationSpec = tween(180)))
                    },
                    label = "desktop-day-transition"
                ) {
                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                        if (medicamentosProgramadosDelDia.isNotEmpty()) {
                            medicamentosProgramadosDelDia.forEach { programacion ->
                                MetallicMedicationCard(modifier = Modifier.fillMaxWidth()) {
                                        Text(programacion.medication.nombre)
                                        Row(
                                            modifier = Modifier.fillMaxWidth(),
                                            horizontalArrangement = Arrangement.spacedBy(12.dp)
                                        ) {
                                            Column(modifier = Modifier.weight(1f)) {
                                                Text("Dosis")
                                                Text(programacion.medication.dosis)
                                            }
                                            Column(modifier = Modifier.weight(1f)) {
                                                Text("Frecuencia")
                                                Text(hoursToCycle(programacion.medication.frecuenciaHoras))
                                            }
                                        }
                                        Text("Horarios del dia")
                                        LazyRow(
                                            modifier = Modifier.fillMaxWidth(),
                                            horizontalArrangement = Arrangement.spacedBy(8.dp)
                                        ) {
                                            items(programacion.tomas, key = { "${programacion.medication.id}-${it.doseTimeMillis}" }) { toma ->
                                                val tomada = tomasRegistradasLookup.containsKey(programacion.medication.id to toma.doseTimeMillis)
                                                Card(
                                                    modifier = Modifier.clickable {
                                                        coroutineScope.launch(Dispatchers.IO) {
                                                            if (tomada) {
                                                                database.medicationIntakeDao().eliminarPorMedicamentoYHorario(
                                                                    programacion.medication.id,
                                                                    toma.doseTimeMillis
                                                                )
                                                            } else {
                                                                database.medicationIntakeDao().guardar(
                                                                    MedicationIntake(
                                                                        medicationId = programacion.medication.id,
                                                                        scheduledAt = toma.doseTimeMillis
                                                                    )
                                                                )
                                                            }
                                                        }
                                                    },
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = if (tomada) Color(0xFFC8E6C9) else Color(0xFFFFF3E0)
                                                    )
                                                ) {
                                                    Text(
                                                        text = toma.hora,
                                                        modifier = Modifier.padding(horizontal = 12.dp, vertical = 8.dp),
                                                        color = if (tomada) Color(0xFF1B5E20) else Color(0xFFE65100)
                                                    )
                                                }
                                            }
                                        }
                                        Text(
                                            text = "Toca una hora para marcarla o desmarcarla como tomada.",
                                            color = Color(0xFF616161)
                                        )
                                }
                            }
                        }
                    }
                }
            }

            if (mostrarPanelPacientes) {
                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors(
                        containerColor = Color(0xB8143468),
                        contentColor = Color(0xFFF3FBFF)
                    )
                ) {
                    Column(
                        modifier = Modifier.padding(16.dp),
                        verticalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Text("Pacientes", fontWeight = FontWeight.Bold)
                        if (perfilesPacientes.isEmpty()) {
                            Text("Todavia no hay pacientes registrados.")
                        } else {
                            Text("Perfil: ${pacienteActivo?.nombre.orEmpty()} ${pacienteActivo?.apellidos.orEmpty()}")
                            Text("Edad: ${pacienteActivo?.edad.orEmpty()} | Peso: ${pacienteActivo?.peso.orEmpty()} ${pacienteActivo?.pesoUnidad.orEmpty()} | Estatura: ${pacienteActivo?.estatura.orEmpty()} ${pacienteActivo?.estaturaUnidad.orEmpty()}")
                            Text("Enfermedades: ${pacienteActivo?.enfermedades.orEmpty()}")
                            LazyRow(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                items(perfilesPacientes, key = { it.id }) { paciente ->
                                    Card(
                                        modifier = Modifier.width(260.dp),
                                        colors = CardDefaults.cardColors(
                                            containerColor = if (paciente.isActive) Color(0xCC1E61B5) else Color(0xB4142D59),
                                            contentColor = Color(0xFFF3FBFF)
                                        )
                                    ) {
                                        Column(
                                            modifier = Modifier.padding(12.dp),
                                            verticalArrangement = Arrangement.spacedBy(6.dp)
                                        ) {
                                            Row(
                                                verticalAlignment = Alignment.CenterVertically,
                                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                                            ) {
                                                Icon(Icons.Default.AccountCircle, contentDescription = null)
                                                Text("${paciente.nombre} ${paciente.apellidos}")
                                            }
                                            Text("Edad: ${paciente.edad} | Peso: ${paciente.peso} ${paciente.pesoUnidad}")
                                            Row(
                                                modifier = Modifier.fillMaxWidth(),
                                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                                            ) {
                                                Button(
                                                    onClick = {
                                                        coroutineScope.launch(Dispatchers.IO) {
                                                            database.patientProfileDao().desactivarTodos()
                                                            database.patientProfileDao().activarPaciente(paciente.id)
                                                        }
                                                    },
                                                    modifier = Modifier.weight(1f)
                                                ) {
                                                    Text(if (paciente.isActive) "Activo" else "Seleccionar")
                                                }
                                                Button(
                                                    onClick = {
                                                        abrirFichaPaciente(paciente, enEdicion = true)
                                                        mostrarFormularioInforme = false
                                                    },
                                                    modifier = Modifier.weight(1f)
                                                ) {
                                                    Text("Editar")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Button(
                            onClick = { cerrarPanelesSecundarios() },
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Text("Volver al escritorio")
                        }
                    }
                }
            }

        if (mostrarFichaPaciente) {
            BackHandler { cancelarFichaPaciente() }
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors()
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(if (editingPatientId == null) "Nuevo perfil" else "Perfil")
                        Row(horizontalArrangement = Arrangement.spacedBy(4.dp), verticalAlignment = Alignment.CenterVertically) {
                            if (editingPatientId != null && !editandoFichaPaciente) {
                                IconButton(onClick = { editandoFichaPaciente = true }) {
                                    Icon(Icons.Default.Edit, contentDescription = "Editar perfil")
                                }
                            }
                            if (editandoFichaPaciente) {
                                IconButton(
                                    onClick = {
                                        if (nombrePaciente.isBlank() || apellidosPaciente.isBlank()) {
                                            Toast.makeText(context, "Completa nombre y apellidos del paciente", Toast.LENGTH_SHORT).show()
                                            return@IconButton
                                        }

                                        val profile = PatientProfile(
                                            id = editingPatientId ?: 0,
                                            nombre = nombrePaciente,
                                            apellidos = apellidosPaciente,
                                            fechaNacimiento = fechaNacimientoPaciente ?: 0L,
                                            edad = edadCalculadaPaciente,
                                            peso = pesoPaciente,
                                            pesoUnidad = pesoUnidadPaciente,
                                            estatura = estaturaPaciente,
                                            estaturaUnidad = estaturaUnidadPaciente,
                                            enfermedades = enfermedadesPaciente,
                                            prescripciones = prescripcionesPaciente,
                                            ultimoAnalisisIa = ultimoAnalisisPaciente,
                                            isActive = true
                                        )

                                        coroutineScope.launch(Dispatchers.IO) {
                                            val creandoNuevoPerfil = editingPatientId == null
                                            database.patientProfileDao().desactivarTodos()
                                            val savedId = database.patientProfileDao().guardar(profile).toInt()
                                            val finalPatientId = when {
                                                savedId > 0 -> savedId
                                                editingPatientId != null -> editingPatientId!!
                                                else -> 0
                                            }
                                            if (finalPatientId > 0) {
                                                database.patientProfileDao().activarPaciente(finalPatientId)
                                            }
                                            withContext(Dispatchers.Main) {
                                                editingPatientId = finalPatientId.takeIf { it > 0 }
                                                if (finalPatientId > 0) {
                                                    cargarFichaPaciente(
                                                        profile.copy(
                                                            id = finalPatientId,
                                                            edad = edadCalculadaPaciente,
                                                            isActive = true
                                                        )
                                                    )
                                                }
                                                editandoFichaPaciente = false
                                                mostrarFichaPaciente = true
                                                Toast.makeText(context, if (creandoNuevoPerfil) "Perfil guardado" else "Perfil actualizado", Toast.LENGTH_SHORT).show()
                                            }
                                        }
                                    }
                                ) {
                                    Icon(Icons.Default.Save, contentDescription = "Guardar perfil")
                                }
                            }
                            IconButton(onClick = { cancelarFichaPaciente() }) {
                                Icon(Icons.Default.Close, contentDescription = "Cancelar")
                            }
                        }
                    }

                    OutlinedTextField(
                        value = nombrePaciente,
                        onValueChange = { if (editandoFichaPaciente) nombrePaciente = it },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Nombre") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = apellidosPaciente,
                        onValueChange = { if (editandoFichaPaciente) apellidosPaciente = it },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Apellidos") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = fechaNacimientoTexto,
                        onValueChange = {},
                        readOnly = true,
                        label = { Text("Fecha de nacimiento") },
                        modifier = Modifier.fillMaxWidth(),
                        trailingIcon = if (editandoFichaPaciente) {
                            {
                                IconButton(
                                    onClick = {
                                        val calendarioNacimiento = Calendar.getInstance().apply {
                                            timeInMillis = fechaNacimientoPaciente ?: System.currentTimeMillis()
                                        }
                                        DatePickerDialog(
                                            context,
                                            { _, year, month, dayOfMonth ->
                                                fechaNacimientoPaciente = Calendar.getInstance().apply {
                                                    set(year, month, dayOfMonth, 0, 0, 0)
                                                    set(Calendar.MILLISECOND, 0)
                                                }.timeInMillis
                                            },
                                            calendarioNacimiento.get(Calendar.YEAR),
                                            calendarioNacimiento.get(Calendar.MONTH),
                                            calendarioNacimiento.get(Calendar.DAY_OF_MONTH)
                                        ).show()
                                    }
                                ) {
                                    Icon(Icons.Default.Edit, contentDescription = "Editar fecha de nacimiento")
                                }
                            }
                        } else null
                    )
                    OutlinedTextField(
                        value = edadPaciente,
                        onValueChange = {},
                        readOnly = true,
                        label = { Text("Edad") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = pesoPaciente,
                        onValueChange = {
                            if (editandoFichaPaciente && (it.isEmpty() || it.matches(Regex("^\\d{0,3}([.,]\\d{0,2})?$")))) pesoPaciente = it
                        },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Peso") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    if (editandoFichaPaciente) {
                        VademecumDropdown(
                            label = "Unidad de peso",
                            options = opcionesPesoUnidad,
                            selectedValue = pesoUnidadPaciente,
                            expanded = expandedPesoUnidad,
                            onExpandedChange = { expandedPesoUnidad = !expandedPesoUnidad },
                            onDismiss = { expandedPesoUnidad = false },
                            onSelect = {
                                pesoUnidadPaciente = it
                                expandedPesoUnidad = false
                            }
                        )
                    } else {
                        OutlinedTextField(
                            value = pesoUnidadPaciente,
                            onValueChange = {},
                            readOnly = true,
                            label = { Text("Unidad de peso") },
                            modifier = Modifier.fillMaxWidth(),
                            singleLine = true
                        )
                    }
                    OutlinedTextField(
                        value = estaturaPaciente,
                        onValueChange = {
                            if (editandoFichaPaciente && (it.isEmpty() || it.matches(Regex("^\\d{0,3}([.,]\\d{0,2})?$")))) estaturaPaciente = it
                        },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Estatura") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    if (editandoFichaPaciente) {
                        VademecumDropdown(
                            label = "Unidad de estatura",
                            options = opcionesEstaturaUnidad,
                            selectedValue = estaturaUnidadPaciente,
                            expanded = expandedEstaturaUnidad,
                            onExpandedChange = { expandedEstaturaUnidad = !expandedEstaturaUnidad },
                            onDismiss = { expandedEstaturaUnidad = false },
                            onSelect = {
                                estaturaUnidadPaciente = it
                                expandedEstaturaUnidad = false
                            }
                        )
                    } else {
                        OutlinedTextField(
                            value = estaturaUnidadPaciente,
                            onValueChange = {},
                            readOnly = true,
                            label = { Text("Unidad de estatura") },
                            modifier = Modifier.fillMaxWidth(),
                            singleLine = true
                        )
                    }
                    OutlinedTextField(
                        value = enfermedadesPaciente,
                        onValueChange = { if (editandoFichaPaciente) enfermedadesPaciente = it },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Enfermedades que padece") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 3
                    )
                    OutlinedTextField(
                        value = prescripcionesPaciente,
                        onValueChange = { if (editandoFichaPaciente) prescripcionesPaciente = it },
                        readOnly = !editandoFichaPaciente,
                        label = { Text("Pautas a seguir o prescripciones medicas") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 4
                    )
                }
            }
        }

        if (mostrarPanelInformes) {
        Card(
            modifier = Modifier.fillMaxWidth(),
            colors = CardDefaults.cardColors()
        ) {
            Column(
                modifier = Modifier.padding(16.dp),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                Text("Informes medicos")
                if (pacienteActivo == null) {
                    Text("Selecciona un paciente para ver sus informes medicos.")
                } else if (reportesMedicos.isEmpty()) {
                    Text("Este paciente aun no tiene informes medicos registrados.")
                } else {
                    LazyRow(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        items(reportesMedicos, key = { it.id }) { reporte ->
                            Card(modifier = Modifier.width(300.dp)) {
                                Column(
                                    modifier = Modifier.padding(12.dp),
                                    verticalArrangement = Arrangement.spacedBy(6.dp)
                                ) {
                                    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                                        Icon(Icons.Default.LocalHospital, contentDescription = null)
                                        Text(reporte.titulo)
                                    }
                                    Text(reporte.descripcion)
                                    if (reporte.analisisIa.isNotBlank()) {
                                        Text("Analisis IA")
                                        Text(reporte.analisisIa)
                                    }
                                    Text("Adjuntos: ${decodeAttachmentPaths(reporte.adjuntos).size}")
                                    val adjuntosReporte = decodeAttachmentPaths(reporte.adjuntos)
                                    if (adjuntosReporte.isNotEmpty()) {
                                        LazyRow(
                                            modifier = Modifier.fillMaxWidth(),
                                            horizontalArrangement = Arrangement.spacedBy(8.dp)
                                        ) {
                                            items(adjuntosReporte.size, key = { index -> adjuntosReporte[index] }) { index ->
                                                val path = adjuntosReporte[index]
                                                AttachmentThumbnail(
                                                    path = path,
                                                    onClick = {
                                                        visorAdjuntos = AttachmentViewerState(
                                                            paths = adjuntosReporte,
                                                            currentIndex = index
                                                        )
                                                    }
                                                )
                                            }
                                        }
                                    }
                                    Row(
                                        modifier = Modifier.fillMaxWidth(),
                                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                                    ) {
                                        Button(
                                            onClick = { cargarInformeMedico(reporte) },
                                            modifier = Modifier.weight(1f)
                                        ) {
                                            Text("Editar")
                                        }
                                        Button(
                                            onClick = {
                                                coroutineScope.launch(Dispatchers.IO) {
                                                    database.medicalReportDao().eliminar(reporte)
                                                }
                                            },
                                            modifier = Modifier.weight(1f)
                                        ) {
                                            Text("Eliminar")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if (pacienteActivo != null) {
                    Card(modifier = Modifier.fillMaxWidth()) {
                        Column(
                            modifier = Modifier.padding(12.dp),
                            verticalArrangement = Arrangement.spacedBy(8.dp)
                        ) {
                            Text("Exportar tomas del paciente")
                            Text("Periodo basado en la fecha seleccionada: $fechaActualTexto")
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                IntakeExportPeriod.entries.forEach { periodo ->
                                    Button(
                                        onClick = {
                                            periodoExportacionPendiente = periodo
                                            exportandoTomas = true
                                            exportMedicationReportLauncher.launch(
                                                "tomas-${periodo.fileSuffix}-${timestampArchivo()}.rtf"
                                            )
                                        },
                                        enabled = !exportandoTomas,
                                        modifier = Modifier.weight(1f)
                                    ) {
                                        Text(periodo.label)
                                    }
                                }
                            }
                            if (exportandoTomas) {
                                Text("Generando informe exportable...")
                            }
                        }
                    }
                }
                Button(
                    onClick = {
                        if (pacienteActivo == null) {
                            abrirNuevaFichaPaciente()
                            Toast.makeText(context, "Primero selecciona o crea un paciente", Toast.LENGTH_SHORT).show()
                        } else {
                            resetInformeMedico()
                            mostrarFormularioInforme = true
                        }
                    },
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text("Nuevo informe medico")
                }
                Button(
                    onClick = { cerrarPanelesSecundarios() },
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text("Volver al escritorio")
                }
            }
        }

        }

        if (mostrarPanelSignosVitales) {
            MetallicRedVitalSignsCard(modifier = Modifier.fillMaxWidth(), verticalSpacing = 10) {
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    verticalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    Text("Signos vitales")
                    Text("Registra presion arterial, latidos, glucemia y temperatura.")

                    OutlinedTextField(
                        value = sistolicaInput,
                        onValueChange = { if (it.isEmpty() || it.matches(Regex("^\\d{0,3}$"))) sistolicaInput = it },
                        label = { Text("Sistolica") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = diastolicaInput,
                        onValueChange = { if (it.isEmpty() || it.matches(Regex("^\\d{0,3}$"))) diastolicaInput = it },
                        label = { Text("Diastolica") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = comentarioPresionInput,
                        onValueChange = { comentarioPresionInput = it },
                        label = { Text("Comentarios de presion arterial") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 2
                    )
                    OutlinedTextField(
                        value = latidosInput,
                        onValueChange = { if (it.isEmpty() || it.matches(Regex("^\\d{0,3}$"))) latidosInput = it },
                        label = { Text("Latidos por minuto") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = comentarioLatidosInput,
                        onValueChange = { comentarioLatidosInput = it },
                        label = { Text("Comentarios de latidos") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 2
                    )
                    OutlinedTextField(
                        value = glucemiaInput,
                        onValueChange = { if (it.isEmpty() || it.matches(Regex("^\\d{0,3}$"))) glucemiaInput = it },
                        label = { Text("Glucemia") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = comentarioGlucemiaInput,
                        onValueChange = { comentarioGlucemiaInput = it },
                        label = { Text("Comentarios de glucemia") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 2
                    )
                    OutlinedTextField(
                        value = temperaturaInput,
                        onValueChange = {
                            if (it.isEmpty() || it.matches(Regex("^\\d{0,2}([.,]\\d?)?$"))) temperaturaInput = it
                        },
                        label = { Text("Temperatura") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = comentarioTemperaturaInput,
                        onValueChange = { comentarioTemperaturaInput = it },
                        label = { Text("Comentarios de temperatura") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 2
                    )

                    Text("Exportar reporte a Word")
                    VademecumDropdown(
                        label = "Filtro de fechas",
                        options = VitalSignsExportFilter.entries.map { it.label },
                        selectedValue = filtroExportacionSignos.label,
                        expanded = expandedFiltroExportacionSignos,
                        onExpandedChange = { expandedFiltroExportacionSignos = !expandedFiltroExportacionSignos },
                        onDismiss = { expandedFiltroExportacionSignos = false },
                        onSelect = { selected ->
                            filtroExportacionSignos = VitalSignsExportFilter.entries.firstOrNull { it.label == selected }
                                ?: VitalSignsExportFilter.TODAY
                            expandedFiltroExportacionSignos = false
                            if (filtroExportacionSignos == VitalSignsExportFilter.TODAY) {
                                fechaInicioExportacionSignos = inicioDelDia(System.currentTimeMillis())
                                fechaFinExportacionSignos = finDelDia(System.currentTimeMillis())
                            }
                        }
                    )

                    if (filtroExportacionSignos == VitalSignsExportFilter.CUSTOM) {
                        DateSelector(
                            label = "Fecha de inicio",
                            selectedDate = fechaInicioExportacionSignos,
                            onPickDate = {
                                val base = Calendar.getInstance().apply { timeInMillis = fechaInicioExportacionSignos }
                                DatePickerDialog(
                                    context,
                                    { _, year, month, dayOfMonth ->
                                        val picked = Calendar.getInstance().apply {
                                            set(year, month, dayOfMonth, 0, 0, 0)
                                            set(Calendar.MILLISECOND, 0)
                                        }
                                        fechaInicioExportacionSignos = inicioDelDia(picked.timeInMillis)
                                        if (fechaFinExportacionSignos < fechaInicioExportacionSignos) {
                                            fechaFinExportacionSignos = finDelDia(fechaInicioExportacionSignos)
                                        }
                                    },
                                    base.get(Calendar.YEAR),
                                    base.get(Calendar.MONTH),
                                    base.get(Calendar.DAY_OF_MONTH)
                                ).show()
                            }
                        )
                        DateSelector(
                            label = "Fecha de fin",
                            selectedDate = fechaFinExportacionSignos,
                            onPickDate = {
                                val base = Calendar.getInstance().apply { timeInMillis = fechaFinExportacionSignos }
                                DatePickerDialog(
                                    context,
                                    { _, year, month, dayOfMonth ->
                                        val picked = Calendar.getInstance().apply {
                                            set(year, month, dayOfMonth, 23, 59, 59)
                                            set(Calendar.MILLISECOND, 999)
                                        }
                                        fechaFinExportacionSignos = finDelDia(picked.timeInMillis)
                                        if (fechaInicioExportacionSignos > fechaFinExportacionSignos) {
                                            fechaInicioExportacionSignos = inicioDelDia(fechaFinExportacionSignos)
                                        }
                                    },
                                    base.get(Calendar.YEAR),
                                    base.get(Calendar.MONTH),
                                    base.get(Calendar.DAY_OF_MONTH)
                                ).show()
                            }
                        )
                    }

                    VitalSignsMetallicButton(
                        text = if (exportandoSignosVitales) "Exportando reporte..." else "Exportar a Word (.docx)",
                        onClick = {
                            val range = resolveVitalSignsExportRange(
                                filter = filtroExportacionSignos,
                                customStart = fechaInicioExportacionSignos,
                                customEnd = fechaFinExportacionSignos
                            )
                            val registrosEnRango = signosVitales
                                .filter { it.fechaRegistro in range.start..range.end }
                                .sortedBy { it.fechaRegistro }
                            if (registrosEnRango.isEmpty()) {
                                Toast.makeText(context, "No hay registros en el filtro seleccionado", Toast.LENGTH_SHORT).show()
                                return@VitalSignsMetallicButton
                            }
                            exportacionSignosPendiente = VitalSignsExportRequest(
                                label = range.label,
                                fileSuffix = range.fileSuffix,
                                records = registrosEnRango
                            )
                            exportandoSignosVitales = true
                            exportVitalSignsReportLauncher.launch(
                                "signos-vitales-${range.fileSuffix}-${timestampArchivo()}.docx"
                            )
                        },
                        modifier = Modifier.fillMaxWidth()
                    )

                    VitalSignsMetallicButton(
                        text = if (mostrarListadoSignosGuardados) "Ocultar listado de registros" else "Ver listado de registros guardados",
                        onClick = {
                            mostrarListadoSignosGuardados = !mostrarListadoSignosGuardados
                            if (!mostrarListadoSignosGuardados) {
                                mostrarVistaPreviaSignosSeleccionados = false
                            }
                        },
                        modifier = Modifier.fillMaxWidth()
                    )

                    if (mostrarListadoSignosGuardados) {
                        if (signosVitales.isEmpty()) {
                            Text("No hay registros guardados para mostrar.")
                        } else {
                            Text("Listado completo de registros")
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                VitalSignsMetallicButton(
                                    text = if (registrosSignosSeleccionados.size == signosVitales.size) "Quitar seleccion total" else "Seleccionar todos",
                                    onClick = {
                                        if (registrosSignosSeleccionados.size == signosVitales.size) {
                                            registrosSignosSeleccionados.clear()
                                            mostrarVistaPreviaSignosSeleccionados = false
                                        } else {
                                            registrosSignosSeleccionados.clear()
                                            registrosSignosSeleccionados.addAll(signosVitales.map { it.id })
                                        }
                                    },
                                    modifier = Modifier.weight(1f)
                                )
                                VitalSignsMetallicButton(
                                    text = "Limpiar seleccion",
                                    onClick = {
                                        registrosSignosSeleccionados.clear()
                                        mostrarVistaPreviaSignosSeleccionados = false
                                    },
                                    modifier = Modifier.weight(1f)
                                )
                            }

                            signosVitales.forEach { registro ->
                                val estaSeleccionado = registrosSignosSeleccionados.contains(registro.id)
                                MetallicRedVitalSignsCard(
                                    modifier = Modifier.fillMaxWidth(),
                                    contentPadding = 10,
                                    verticalSpacing = 0
                                ) {
                                    Row(
                                        modifier = Modifier.fillMaxWidth(),
                                        horizontalArrangement = Arrangement.spacedBy(10.dp),
                                        verticalAlignment = Alignment.CenterVertically
                                    ) {
                                        Checkbox(
                                            checked = estaSeleccionado,
                                            onCheckedChange = { checked ->
                                                if (checked) {
                                                    if (!registrosSignosSeleccionados.contains(registro.id)) {
                                                        registrosSignosSeleccionados.add(registro.id)
                                                    }
                                                } else {
                                                    registrosSignosSeleccionados.remove(registro.id)
                                                }
                                                if (registrosSignosSeleccionados.isEmpty()) {
                                                    mostrarVistaPreviaSignosSeleccionados = false
                                                }
                                            }
                                        )
                                        Text(
                                            text = formatDateTime(registro.fechaRegistro),
                                            modifier = Modifier.weight(1f)
                                        )
                                    }
                                }
                            }

                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                VitalSignsMetallicButton(
                                    text = if (mostrarVistaPreviaSignosSeleccionados) "Ocultar visualizacion" else "Visualizar seleccion",
                                    onClick = {
                                        if (signosVitalesSeleccionados.isEmpty()) {
                                            Toast.makeText(context, "Selecciona al menos un registro", Toast.LENGTH_SHORT).show()
                                            return@VitalSignsMetallicButton
                                        }
                                        mostrarVistaPreviaSignosSeleccionados = !mostrarVistaPreviaSignosSeleccionados
                                    },
                                    modifier = Modifier.weight(1f)
                                )
                                VitalSignsMetallicButton(
                                    text = "Exportar seleccion (.docx)",
                                    onClick = {
                                        if (signosVitalesSeleccionados.isEmpty()) {
                                            Toast.makeText(context, "Selecciona al menos un registro para exportar", Toast.LENGTH_SHORT).show()
                                            return@VitalSignsMetallicButton
                                        }
                                        val etiquetaSeleccion = if (signosVitalesSeleccionados.size == 1) {
                                            "Registro del ${formatDateTime(signosVitalesSeleccionados.first().fechaRegistro)}"
                                        } else {
                                            "Seleccion manual (${signosVitalesSeleccionados.size} registros)"
                                        }
                                        exportacionSignosPendiente = VitalSignsExportRequest(
                                            label = etiquetaSeleccion,
                                            fileSuffix = "seleccion",
                                            records = signosVitalesSeleccionados
                                        )
                                        exportandoSignosVitales = true
                                        exportVitalSignsReportLauncher.launch(
                                            "signos-vitales-seleccion-${timestampArchivo()}.docx"
                                        )
                                    },
                                    modifier = Modifier.weight(1f)
                                )
                            }

                            if (mostrarVistaPreviaSignosSeleccionados && signosVitalesSeleccionados.isNotEmpty()) {
                                Text("Visualizacion de seleccion")
                                signosVitalesSeleccionados.forEach { registro ->
                                    MetallicRedVitalSignsCard(
                                        modifier = Modifier.fillMaxWidth(),
                                        contentPadding = 12,
                                        verticalSpacing = 4
                                    ) {
                                        Column(
                                            modifier = Modifier.fillMaxWidth(),
                                            verticalArrangement = Arrangement.spacedBy(4.dp)
                                        ) {
                                            Text("Presion: ${registro.sistolica}/${registro.diastolica}")
                                            if (registro.comentarioPresion.isNotBlank()) {
                                                Text("Comentario presion: ${registro.comentarioPresion}")
                                            }
                                            Text("Latidos: ${registro.latidos} lpm")
                                            if (registro.comentarioLatidos.isNotBlank()) {
                                                Text("Comentario latidos: ${registro.comentarioLatidos}")
                                            }
                                            Text("Glucemia: ${registro.glucemia?.toString() ?: "Sin dato"}")
                                            if (registro.comentarioGlucemia.isNotBlank()) {
                                                Text("Comentario glucemia: ${registro.comentarioGlucemia}")
                                            }
                                            Text("Temperatura: ${registro.temperatura?.let(::formatTemperature) ?: "Sin dato"}")
                                            if (registro.comentarioTemperatura.isNotBlank()) {
                                                Text("Comentario temperatura: ${registro.comentarioTemperatura}")
                                            }
                                            Text("Registro: ${formatDateTime(registro.fechaRegistro)}")
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VitalSignsMetallicButton(
                        text = "Guardar registro",
                        onClick = {
                            val sistolica = sistolicaInput.toIntOrNull()
                            val diastolica = diastolicaInput.toIntOrNull()
                            val latidos = latidosInput.toIntOrNull()
                            val glucemia = glucemiaInput.toIntOrNull()
                            val temperatura = temperaturaInput.replace(',', '.').toDoubleOrNull()

                            if (sistolica == null || diastolica == null || latidos == null || glucemia == null || temperatura == null) {
                                Toast.makeText(context, "Completa presion, latidos, glucemia y temperatura antes de guardar", Toast.LENGTH_SHORT).show()
                                return@VitalSignsMetallicButton
                            }

                            coroutineScope.launch(Dispatchers.IO) {
                                database.signosVitalesDao().insertar(
                                    SignosVitales(
                                        sistolica = sistolica,
                                        diastolica = diastolica,
                                        comentarioPresion = comentarioPresionInput,
                                        latidos = latidos,
                                        comentarioLatidos = comentarioLatidosInput,
                                        glucemia = glucemia,
                                        comentarioGlucemia = comentarioGlucemiaInput,
                                        temperatura = temperatura,
                                        comentarioTemperatura = comentarioTemperaturaInput
                                    )
                                )
                                withContext(Dispatchers.Main) {
                                    sistolicaInput = ""
                                    diastolicaInput = ""
                                    comentarioPresionInput = ""
                                    latidosInput = ""
                                    comentarioLatidosInput = ""
                                    glucemiaInput = ""
                                    comentarioGlucemiaInput = ""
                                    temperaturaInput = ""
                                    comentarioTemperaturaInput = ""
                                    Toast.makeText(context, "Signos vitales guardados", Toast.LENGTH_SHORT).show()
                                }
                            }
                        },
                        modifier = Modifier.fillMaxWidth()
                    )

                    VitalSignsMetallicButton(
                        text = "Volver al escritorio",
                        onClick = { cerrarPanelesSecundarios() },
                        modifier = Modifier.fillMaxWidth()
                    )
                }
            }

        }

        if (mostrarPanelConfiguracionAlertas) {
            val panelFieldColors = metallicBlueTextFieldColors()
            val panelButtonColors = metallicBlueButtonColors()
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(containerColor = Color(0xFF050505)),
                border = BorderStroke(1.dp, Color.White.copy(alpha = 0.10f))
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    Text("Configuracion de alertas criticas", color = Color.White)
                    Text(
                        "Esta configuracion se aplica a todos los medicamentos con alarma activa.",
                        color = Color(0xFFE8EDF3)
                    )

                    VademecumDropdown(
                        label = "Intervalo de reintento",
                        options = opcionesReintentoCritico.map { "$it min" },
                        selectedValue = "$intervaloReintentoSeleccionado min",
                        expanded = expandedReintentoCritico,
                        onExpandedChange = { expandedReintentoCritico = !expandedReintentoCritico },
                        onDismiss = { expandedReintentoCritico = false },
                        onSelect = {
                            intervaloReintentoSeleccionado = it.substringBefore(' ').toIntOrNull()
                                ?.let(::normalizarReintentoCritico)
                                ?: CriticalAlertSettings.DEFAULT_RETRY_INTERVAL_MINUTES
                            expandedReintentoCritico = false
                        },
                        colors = panelFieldColors
                    )

                    VademecumDropdown(
                        label = "Numero de repeticiones",
                        options = opcionesNumeroRepeticionesCritico,
                        selectedValue = numeroRepeticionesCriticoSeleccionado.toString(),
                        expanded = expandedNumeroRepeticionesCritico,
                        onExpandedChange = { expandedNumeroRepeticionesCritico = !expandedNumeroRepeticionesCritico },
                        onDismiss = { expandedNumeroRepeticionesCritico = false },
                        onSelect = {
                            numeroRepeticionesCriticoSeleccionado = it.toIntOrNull()
                                ?.let(CriticalAlertSettings::normalizeMaxRetryCount)
                                ?: CriticalAlertSettings.DEFAULT_MAX_RETRY_COUNT
                            expandedNumeroRepeticionesCritico = false
                        },
                        colors = panelFieldColors
                    )

                    Text(
                        text = if (numeroRepeticionesCriticoSeleccionado == 0) {
                            "Tras la alerta inicial, no se repetira automaticamente si no se confirma ni se pospone."
                        } else {
                            "Tras la alerta inicial, se repetira hasta $numeroRepeticionesCriticoSeleccionado veces cada $intervaloReintentoSeleccionado minutos si no se confirma ni se pospone."
                        },
                        color = Color(0xFFE8EDF3)
                    )

                    Text("Sonido critico", color = Color.White)
                    Text(alarmaSonidoNombre, color = Color(0xFFE8EDF3))
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Button(
                            onClick = {
                                ringtonePickerLauncher.launch(buildRingtonePickerIntent(alarmaSonidoUri))
                            },
                            modifier = Modifier.weight(1f),
                            colors = panelButtonColors
                        ) {
                            Text("Elegir sonido")
                        }
                        Button(
                            onClick = {
                                alarmaSonidoUri = ""
                                alarmaSonidoNombre = "Alarma predeterminada"
                            },
                            modifier = Modifier.weight(1f),
                            colors = panelButtonColors
                        ) {
                            Text("Predeterminada")
                        }
                    }

                    Text("Permisos del sistema", color = Color.White)
                    if (!tienePermisoNotificaciones) {
                        Text(
                            "Activa las notificaciones para que las alertas puedan mostrarse.",
                            color = Color(0xFFE8EDF3)
                        )
                        Button(
                            onClick = { notificationPermissionLauncher.launch(Manifest.permission.POST_NOTIFICATIONS) },
                            modifier = Modifier.fillMaxWidth(),
                            colors = panelButtonColors
                        ) {
                            Text("Permitir notificaciones")
                        }
                    }
                    if (!tienePermisoAlarmaExacta) {
                        Text(
                            "Permite alarmas exactas para disparar el recordatorio a la hora prevista.",
                            color = Color(0xFFE8EDF3)
                        )
                        Button(
                            onClick = { exactAlarmPermissionLauncher.launch(buildExactAlarmPermissionIntent(context)) },
                            modifier = Modifier.fillMaxWidth(),
                            colors = panelButtonColors
                        ) {
                            Text("Permitir alarmas exactas")
                        }
                    }
                    if (!tieneAccesoNoMolestar) {
                        Text(
                            "Concede acceso a No molestar para que la alerta critica intente sobresalir sobre ese filtro.",
                            color = Color(0xFFE8EDF3)
                        )
                        Button(
                            onClick = { notificationPolicyAccessLauncher.launch(buildNotificationPolicyAccessIntent()) },
                            modifier = Modifier.fillMaxWidth(),
                            colors = panelButtonColors
                        ) {
                            Text("Permitir alertas criticas")
                        }
                    }
                    if (tienePermisoNotificaciones && tienePermisoAlarmaExacta && tieneAccesoNoMolestar) {
                        Text("Todos los permisos criticos ya estan concedidos.", color = Color(0xFFE8EDF3))
                    }

                    Button(
                        onClick = {
                            guardarConfiguracionAlertasCriticas()
                            Toast.makeText(context, "Configuracion de alertas actualizada", Toast.LENGTH_SHORT).show()
                        },
                        modifier = Modifier.fillMaxWidth(),
                        colors = panelButtonColors
                    ) {
                        Text("Guardar configuracion")
                    }
                    Button(
                        onClick = { cerrarPanelesSecundarios() },
                        modifier = Modifier.fillMaxWidth(),
                        colors = panelButtonColors
                    ) {
                        Text("Volver al escritorio")
                    }
                }
            }
        }

        if (mostrarPanelConfiguracionIa) {
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors()
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    Text("Configuracion IA clinica")
                    Text("Para este entorno se usa la IP Wi‑Fi de la PC. En la app debes guardar la URL completa del API, por ejemplo http://192.168.40.162:11434/api/generate. En el navegador del telefono puedes probar solo la base http://192.168.40.162:11434 para verificar que Ollama esta activo.")
                    Text("Si el telefono no conecta, confirma que ambos dispositivos estan en la misma Wi‑Fi, que OLLAMA_HOST esta en 0.0.0.0 y que el Firewall de Windows no bloquea el puerto 11434.")
                    OutlinedTextField(
                        value = urlServicioIa,
                        onValueChange = { urlServicioIa = it },
                        label = { Text("URL del servicio") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = modeloServicioIa,
                        onValueChange = { modeloServicioIa = it },
                        label = { Text("Modelo") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    Button(
                        onClick = {
                            guardarConfiguracionIa()
                            Toast.makeText(context, "Configuracion IA guardada", Toast.LENGTH_SHORT).show()
                        },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("Guardar configuracion")
                    }
                    Button(
                        onClick = { cerrarPanelesSecundarios() },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("Volver al escritorio")
                    }
                }
            }
        }

        if (mostrarPanelBackups) {
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors()
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text("Copias de seguridad")
                    Text(
                        when (frecuenciaBackupSeleccionada) {
                            AutoBackupScheduler.FREQUENCY_DAILY -> "Backup automatico: diario"
                            AutoBackupScheduler.FREQUENCY_WEEKLY -> "Backup automatico: semanal"
                            else -> "Backup automatico: desactivado"
                        }
                    )
                    if (ultimoBackupAutomatico != null) {
                        Text("Ultimo backup automatico: ${formatDateTime(ultimoBackupAutomatico.lastModified())}")
                        Text("Ruta interna: ${ultimoBackupAutomatico.absolutePath}")
                    } else {
                        Text("Todavia no hay backup automatico generado.")
                    }
                    if (mensajeBackup.isNotBlank()) {
                        Text(mensajeBackup)
                    }

                    VademecumDropdown(
                        label = "Frecuencia programada",
                        options = opcionesFrecuenciaBackup,
                        selectedValue = frecuenciaBackupLabel(frecuenciaBackupSeleccionada),
                        expanded = expandedFrecuenciaBackup,
                        onExpandedChange = { expandedFrecuenciaBackup = !expandedFrecuenciaBackup },
                        onDismiss = { expandedFrecuenciaBackup = false },
                        onSelect = {
                            frecuenciaBackupSeleccionada = when (it) {
                                "Diario" -> AutoBackupScheduler.FREQUENCY_DAILY
                                "Semanal" -> AutoBackupScheduler.FREQUENCY_WEEKLY
                                else -> AutoBackupScheduler.FREQUENCY_MANUAL
                            }
                            expandedFrecuenciaBackup = false
                        }
                    )

                    Button(
                        onClick = { mostrarDialogoProgramarBackup = true },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("Guardar programacion")
                    }
                    Button(
                        onClick = { mostrarDialogoBackupManual = true },
                        enabled = !ejecutandoBackupManual,
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text(if (ejecutandoBackupManual) "Creando backup..." else "Crear backup manual")
                    }
                    Button(
                        onClick = {
                            restaurandoBackup = true
                            restoreBackupDocumentLauncher.launch(arrayOf("application/json", "text/plain"))
                        },
                        enabled = !restaurandoBackup,
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text(if (restaurandoBackup) "Restaurando backup..." else "Restaurar backup manual")
                    }
                    Button(
                        onClick = { cerrarPanelesSecundarios() },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("Volver al escritorio")
                    }
                }
            }
        }

        if (mostrarFormularioInforme) {
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors()
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text("Formulario de informe medico")
                    OutlinedTextField(
                        value = tituloInforme,
                        onValueChange = { tituloInforme = it },
                        label = { Text("Titulo del informe") },
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = descripcionInforme,
                        onValueChange = { descripcionInforme = it },
                        label = { Text("Descripcion o hallazgos") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 4
                    )
                    OutlinedTextField(
                        value = analisisInformeIa,
                        onValueChange = { analisisInformeIa = it },
                        label = { Text("Analisis IA") },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 6
                    )
                    Button(
                        onClick = {
                            val activePatient = pacienteActivo
                            if (activePatient == null) {
                                Toast.makeText(context, "Selecciona un paciente primero", Toast.LENGTH_SHORT).show()
                                return@Button
                            }
                            if (urlServicioIa.isBlank() || modeloServicioIa.isBlank()) {
                                Toast.makeText(context, "Configura primero la IA en el menu hamburguesa", Toast.LENGTH_SHORT).show()
                                return@Button
                            }

                            guardarConfiguracionIa()
                            generandoAnalisisIa = true
                            coroutineScope.launch(Dispatchers.IO) {
                                try {
                                    val prompt = buildMedicalReportAiPrompt(
                                        patient = activePatient,
                                        latestVitalSigns = signosVitales.firstOrNull(),
                                        medications = medicamentosGuardados,
                                        reportTitle = tituloInforme,
                                        reportDescription = descripcionInforme
                                    )
                                    val response = OllamaMedicalAiClient.generateClinicalReport(
                                        config = MedicalAiConfig(
                                            endpointUrl = urlServicioIa.trim(),
                                            modelName = modeloServicioIa.trim()
                                        ),
                                        prompt = prompt
                                    )
                                    withContext(Dispatchers.Main) {
                                        generandoAnalisisIa = false
                                        analisisInformeIa = response
                                        Toast.makeText(context, "Analisis IA generado", Toast.LENGTH_SHORT).show()
                                    }
                                } catch (exception: Exception) {
                                    withContext(Dispatchers.Main) {
                                        generandoAnalisisIa = false
                                        Toast.makeText(
                                            context,
                                            "No se pudo generar el analisis IA: ${exception.message ?: "error desconocido"}",
                                            Toast.LENGTH_LONG
                                        ).show()
                                    }
                                }
                            }
                        },
                        enabled = !generandoAnalisisIa,
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text(if (generandoAnalisisIa) "Generando analisis..." else "Generar analisis IA")
                    }
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Button(
                            onClick = {
                                if (tienePermisoCamara) {
                                    takeStudyPictureLauncher.launch(null)
                                } else {
                                    cameraPermissionPending = true
                                    cameraPermissionLauncher.launch(Manifest.permission.CAMERA)
                                }
                            },
                            modifier = Modifier.weight(1f)
                        ) {
                            Text("Fotografiar")
                        }
                        Button(
                            onClick = { pickStudyImagesLauncher.launch("image/*") },
                            modifier = Modifier.weight(1f)
                        ) {
                            Text("Galeria")
                        }
                    }
                    if (estudiosAdjuntos.isNotEmpty()) {
                        estudiosAdjuntos.forEachIndexed { index, path ->
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.spacedBy(8.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                AttachmentThumbnail(
                                    path = path,
                                    modifier = Modifier.size(72.dp),
                                    onClick = {
                                        visorAdjuntos = AttachmentViewerState(
                                            paths = estudiosAdjuntos.toList(),
                                            currentIndex = index
                                        )
                                    }
                                )
                                Text(attachmentDisplayName(path, index), modifier = Modifier.weight(1f))
                                Button(onClick = { estudiosAdjuntos.remove(path) }) {
                                    Text("Quitar")
                                }
                            }
                        }
                    }
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Button(
                            onClick = {
                                val activePatient = pacienteActivo
                                if (activePatient == null) {
                                    Toast.makeText(context, "Selecciona un paciente primero", Toast.LENGTH_SHORT).show()
                                    return@Button
                                }
                                if (tituloInforme.isBlank()) {
                                    Toast.makeText(context, "Indica un titulo para el informe", Toast.LENGTH_SHORT).show()
                                    return@Button
                                }
                                val reportBase = MedicalReport(
                                    id = editingReportId ?: 0,
                                    patientId = activePatient.id,
                                    titulo = tituloInforme,
                                    descripcion = descripcionInforme,
                                    adjuntos = estudiosAdjuntos.joinToString("|"),
                                    analisisIa = analisisInformeIa
                                )
                                coroutineScope.launch(Dispatchers.IO) {
                                    database.medicalReportDao().guardar(reportBase)
                                    withContext(Dispatchers.Main) {
                                        resetInformeMedico()
                                        mostrarFormularioInforme = false
                                        mostrarPanelInformes = true
                                        Toast.makeText(
                                            context,
                                            "Informe medico guardado",
                                            Toast.LENGTH_SHORT
                                        ).show()
                                    }
                                }
                            },
                            modifier = Modifier.weight(1f)
                        ) {
                            Text("Guardar informe")
                        }
                        Button(
                            onClick = {
                                resetInformeMedico()
                                cerrarPanelesSecundarios()
                            },
                            modifier = Modifier.weight(1f)
                        ) {
                            Text("Cerrar")
                        }
                    }
                }
            }
        }

        medicationToDelete?.let { medication ->
            AlertDialog(
                onDismissRequest = { medicationToDelete = null },
                title = { Text("Eliminar medicamento") },
                text = { Text("La eliminacion del medicamento es irreversible. Esta seguro?") },
                confirmButton = {
                    Button(
                        onClick = {
                            medicationToDelete = null
                            coroutineScope.launch(Dispatchers.IO) {
                                database.medicationDao().eliminar(medication)
                                MedicationScheduler(context).cancelarAlarma(medication.id)
                                withContext(Dispatchers.Main) {
                                    if (editingMedicationId == medication.id) {
                                        resetForm()
                                    }
                                    Toast.makeText(context, "Medicamento eliminado", Toast.LENGTH_SHORT).show()
                                }
                            }
                        },
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF2E7D32))
                    ) {
                        Text("✓")
                    }
                },
                dismissButton = {
                    Button(
                        onClick = { medicationToDelete = null },
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFFC62828))
                    ) {
                        Text("X")
                    }
                }
            )
        }

        duplicateMedication?.let { medication ->
            AlertDialog(
                onDismissRequest = { duplicateMedication = null },
                title = { Text("Medicamento ya existe") },
                text = { Text("Ya existe un medicamento guardado con estos datos. Deseas modificar el registro existente?") },
                confirmButton = {
                    Button(
                        onClick = {
                            duplicateMedication = null
                            cargarMedicamentoEnFormulario(medication)
                            Toast.makeText(context, "Se cargo el medicamento existente para modificarlo", Toast.LENGTH_SHORT).show()
                        }
                    ) {
                        Text("Modificar")
                    }
                },
                dismissButton = {
                    Button(onClick = { duplicateMedication = null }) {
                        Text("Cancelar")
                    }
                }
            )
        }

        intakeToDelete?.let { pendingDeletion ->
            AlertDialog(
                onDismissRequest = { intakeToDelete = null },
                title = { Text("Eliminar registro de toma") },
                text = {
                    Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                        Text("La modificacion del registro real es irreversible. Desea continuar?")
                        Text("Medicamento: ${pendingDeletion.medicationName}\nHora programada: ${formatHour(pendingDeletion.scheduledAt)}")
                    }
                },
                confirmButton = {
                    Button(
                        onClick = {
                            val currentDeletion = intakeToDelete ?: return@Button
                            intakeToDelete = null
                            coroutineScope.launch(Dispatchers.IO) {
                                database.medicationIntakeDao().eliminarPorMedicamentoYHorario(
                                    currentDeletion.medicationId,
                                    currentDeletion.scheduledAt
                                )
                            }
                        },
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF2E7D32))
                    ) {
                        Text("✓")
                    }
                },
                dismissButton = {
                    Button(
                        onClick = { intakeToDelete = null },
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFFC62828))
                    ) {
                        Text("X")
                    }
                }
            )
        }

        if (mostrarDialogoBackupManual) {
            AlertDialog(
                onDismissRequest = { mostrarDialogoBackupManual = false },
                title = { Text("Crear backup manual") },
                text = { Text("Se va a generar una copia de seguridad en un archivo JSON. Deseas continuar?") },
                confirmButton = {
                    Button(
                        onClick = {
                            mostrarDialogoBackupManual = false
                            ejecutandoBackupManual = true
                            createBackupDocumentLauncher.launch("controlmedicamentos-backup-${timestampArchivo()}.json")
                        }
                    ) {
                        Text("Hacer backup")
                    }
                },
                dismissButton = {
                    Button(onClick = { mostrarDialogoBackupManual = false }) {
                        Text("Cancelar")
                    }
                }
            )
        }

        if (mostrarDialogoProgramarBackup) {
            AlertDialog(
                onDismissRequest = { mostrarDialogoProgramarBackup = false },
                title = { Text("Programar backup") },
                text = {
                    Text(
                        when (frecuenciaBackupSeleccionada) {
                            AutoBackupScheduler.FREQUENCY_DAILY -> "Se programara un backup automatico diario en el almacenamiento interno de la app."
                            AutoBackupScheduler.FREQUENCY_WEEKLY -> "Se programara un backup automatico semanal en el almacenamiento interno de la app."
                            else -> "Se desactivaran los backups automaticos."
                        }
                    )
                },
                confirmButton = {
                    Button(
                        onClick = {
                            mostrarDialogoProgramarBackup = false
                            AutoBackupScheduler.applySchedule(context, frecuenciaBackupSeleccionada)
                            mensajeBackup = "Programacion de backup actualizada"
                            Toast.makeText(context, mensajeBackup, Toast.LENGTH_SHORT).show()
                        }
                    ) {
                        Text("Aceptar")
                    }
                },
                dismissButton = {
                    Button(onClick = { mostrarDialogoProgramarBackup = false }) {
                        Text("Cancelar")
                    }
                }
            )
        }

        if (mostrarListaMedicamentos) {
            Text("Medicamentos guardados")

            if (medicamentosGuardados.isEmpty()) {
                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors()
                ) {
                    Text(
                        text = "Aun no hay medicamentos registrados.",
                        modifier = Modifier.padding(16.dp)
                    )
                }
            } else {
                LazyRow(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    items(medicamentosGuardados, key = { it.id }) { medicamento ->
                        MetallicMedicationCard(
                            modifier = Modifier.width(300.dp),
                            contentPadding = 12,
                            verticalSpacing = 4
                        ) {
                                Text(medicamento.nombre)
                                Text("Formato: ${medicamento.formato.ifBlank { "No indicado" }}")
                                Text("Presentación: ${medicamento.presentacion.ifBlank { "No indicada" }}")
                                Text("Concentración: ${medicamento.concentracion.ifBlank { "No indicada" }}")
                                Text("Cantidad: ${medicamento.dosis}")
                                Text("Reparto: ${medicamento.repartoDosis.ifBlank { "En una sola toma" }}")
                                if (medicamento.horariosTomas.isNotBlank()) {
                                    Text("Horarios: ${medicamento.horariosTomas.replace("|", ", ")}")
                                } else if (medicamento.horaToma.isNotBlank()) {
                                    Text("Hora de toma: ${medicamento.horaToma}")
                                }
                                Text("Alarma: ${if (medicamento.alarmaActiva) "Activa" else "Desactivada"}")
                                Text("Inicio: ${formatDate(medicamento.fechaInicio)}")
                                if (medicamento.esCicloCorto) {
                                    Text("Fin: ${formatDate(medicamento.fechaFin)}")
                                }
                                Row(
                                    modifier = Modifier.fillMaxWidth(),
                                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                                ) {
                                    Button(
                                        onClick = {
                                            cerrarPanelesSecundarios()
                                            cargarMedicamentoEnFormulario(medicamento)
                                            mostrarFormulario = true
                                        },
                                        modifier = Modifier.weight(1f)
                                    ) {
                                        Text("Editar")
                                    }
                                    Button(
                                        onClick = { medicationToDelete = medicamento },
                                        modifier = Modifier.weight(1f)
                                    ) {
                                        Text("Eliminar")
                                    }
                                }
                                Button(
                                    onClick = {
                                        coroutineScope.launch(Dispatchers.IO) {
                                            val nuevoEstado = !medicamento.alarmaActiva
                                            database.medicationDao().cambiarAlarmaActiva(medicamento.id, nuevoEstado)
                                            val actualizado = medicamento.copy(alarmaActiva = nuevoEstado)
                                            if (nuevoEstado) {
                                                MedicationScheduler(context).programarAlarmas(actualizado)
                                            } else {
                                                MedicationScheduler(context).cancelarAlarma(medicamento.id)
                                            }
                                            withContext(Dispatchers.Main) {
                                                if (editingMedicationId == medicamento.id) {
                                                    alarmaActiva = nuevoEstado
                                                }
                                                Toast.makeText(
                                                    context,
                                                    if (nuevoEstado) "Alarma activada" else "Alarma desactivada",
                                                    Toast.LENGTH_SHORT
                                                ).show()
                                            }
                                        }
                                    },
                                    modifier = Modifier.fillMaxWidth()
                                ) {
                                    Text(if (medicamento.alarmaActiva) "Desactivar alarma" else "Activar alarma")
                                }
                        }
                    }
                }
            }

            Button(
                onClick = { cerrarPanelesSecundarios() },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("Volver al escritorio")
            }
            }

            if (mostrarFormulario) {
                val formTextFieldColors = metallicBlueTextFieldColors()
                val formButtonColors = metallicBlueButtonColors()
                MetallicMedicationCard(
                    modifier = Modifier.fillMaxWidth(),
                    contentPadding = 18,
                    verticalSpacing = 12
                ) {
                    CompositionLocalProvider(LocalContentColor provides Color.White) {
                        Text(
                            text = "Formulario de medicamento",
                            color = Color(0xFFE8F8FF),
                            fontSize = 20.sp,
                            fontWeight = FontWeight.SemiBold
                        )

                        ExposedDropdownMenuBox(
                            expanded = expandedNombre && sugerencias.isNotEmpty(),
                            onExpandedChange = { expandedNombre = !expandedNombre }
                        ) {
                            OutlinedTextField(
                                value = nombre,
                                onValueChange = {
                                    nombre = it
                                    expandedNombre = it.isNotBlank()
                                },
                                label = { Text("Nombre del medicamento") },
                                modifier = Modifier.menuAnchor().fillMaxWidth(),
                                singleLine = true,
                                trailingIcon = {
                                    ExposedDropdownMenuDefaults.TrailingIcon(expanded = expandedNombre && sugerencias.isNotEmpty())
                                },
                                colors = formTextFieldColors
                            )
                            ExposedDropdownMenu(
                                expanded = expandedNombre && sugerencias.isNotEmpty(),
                                onDismissRequest = { expandedNombre = false }
                            ) {
                                sugerencias.forEach { medicamento ->
                                    DropdownMenuItem(
                                        text = { Text(medicamento.nombre) },
                                        onClick = {
                                            nombre = medicamento.nombre
                                            selectedMedication = medicamento
                                            formatoSeleccionado = medicamento.formatos.firstOrNull().orEmpty()
                                            presentacionPersistida = medicamento.presentaciones.firstOrNull().orEmpty()
                                            concentracionSeleccionada = medicamento.concentraciones.firstOrNull().orEmpty()
                                            expandedNombre = false
                                        }
                                    )
                                }
                            }
                        }

                        OutlinedTextField(
                            value = cantidad,
                            onValueChange = { if (it.all(Char::isDigit)) cantidad = it },
                            label = { Text("Cantidad") },
                            modifier = Modifier.fillMaxWidth(),
                            singleLine = true,
                            colors = formTextFieldColors
                        )

                        val cantidadInt = cantidad.toIntOrNull() ?: 0
                        if (cantidadInt > 1) {
                            ExposedDropdownMenuBox(
                                expanded = expandedToma,
                                onExpandedChange = { expandedToma = !expandedToma }
                            ) {
                                OutlinedTextField(
                                    value = tomaSeleccionada,
                                    onValueChange = {},
                                    readOnly = true,
                                    label = { Text("Reparto de la cantidad") },
                                    trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded = expandedToma) },
                                    modifier = Modifier.menuAnchor().fillMaxWidth(),
                                    colors = formTextFieldColors
                                )
                                ExposedDropdownMenu(
                                    expanded = expandedToma,
                                    onDismissRequest = { expandedToma = false }
                                ) {
                                    opcionesToma.forEach { opcion ->
                                        DropdownMenuItem(
                                            text = { Text(opcion) },
                                            onClick = {
                                                tomaSeleccionada = opcion
                                                expandedToma = false
                                            }
                                        )
                                    }
                                }
                            }

                            if (tomaSeleccionada == "En diferentes horarios") {
                                val maxTomas = cantidadInt.coerceAtMost(5)
                                for (i in 0 until maxTomas) {
                                    val horaActual = horasTomas.getOrNull(i).orEmpty()
                                    Row(
                                        modifier = Modifier.fillMaxWidth(),
                                        verticalAlignment = Alignment.CenterVertically,
                                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                                    ) {
                                        Text(
                                            text = "Toma ${i + 1}",
                                            modifier = Modifier.weight(1f)
                                        )
                                        Button(
                                            onClick = {
                                                while (horasTomas.size <= i) {
                                                    horasTomas.add("")
                                                }
                                                TimePickerDialog(
                                                    context,
                                                    { _, hour, minute ->
                                                        horasTomas[i] = String.format("%02d:%02d", hour, minute)
                                                    },
                                                    8,
                                                    0,
                                                    true
                                                ).show()
                                            },
                                            colors = formButtonColors
                                        ) {
                                            Text(if (horaActual.isBlank()) "Seleccionar hora" else horaActual)
                                        }
                                    }
                                }
                            }
                        }

                        val usaHoraUnica = cantidadInt <= 1 || tomaSeleccionada == "En una sola toma"
                        if (usaHoraUnica) {
                            TransparentFormSectionCard(modifier = Modifier.fillMaxWidth()) {
                                Text("Hora de la toma")
                                OutlinedTextField(
                                    value = horaTomaSeleccionada.ifBlank { "Selecciona una hora" },
                                    onValueChange = {},
                                    readOnly = true,
                                    label = { Text("Hora de la toma") },
                                    modifier = Modifier.fillMaxWidth(),
                                    trailingIcon = {
                                        Button(
                                            onClick = {
                                                val horaBase = horaTomaSeleccionada.ifBlank { "08:00" }.split(":")
                                                val horaInicial = horaBase.getOrNull(0)?.toIntOrNull() ?: 8
                                                val minutoInicial = horaBase.getOrNull(1)?.toIntOrNull() ?: 0
                                                TimePickerDialog(
                                                    context,
                                                    { _, hour, minute ->
                                                        horaTomaSeleccionada = String.format("%02d:%02d", hour, minute)
                                                    },
                                                    horaInicial,
                                                    minutoInicial,
                                                    true
                                                ).show()
                                            },
                                            colors = formButtonColors
                                        ) {
                                            Text("Elegir")
                                        }
                                    },
                                    colors = formTextFieldColors
                                )
                            }
                        }

                        VademecumDropdown(
                            label = "Formato",
                            options = selectedMedication?.formatos.orEmpty(),
                            selectedValue = formatoSeleccionado,
                            expanded = expandedFormato,
                            onExpandedChange = { expandedFormato = !expandedFormato },
                            onDismiss = { expandedFormato = false },
                            onSelect = {
                                formatoSeleccionado = it
                                expandedFormato = false
                            },
                            colors = formTextFieldColors
                        )

                        VademecumDropdown(
                            label = "Concentración",
                            options = selectedMedication?.concentraciones.orEmpty(),
                            selectedValue = concentracionSeleccionada,
                            expanded = expandedConcentracion,
                            onExpandedChange = { expandedConcentracion = !expandedConcentracion },
                            onDismiss = { expandedConcentracion = false },
                            onSelect = {
                                concentracionSeleccionada = it
                                expandedConcentracion = false
                            },
                            colors = formTextFieldColors
                        )

                        Button(
                            onClick = {
                                concentracionPersonalizadaInput = concentracionSeleccionada
                                mostrarDialogoConcentracionPersonalizada = true
                            },
                            modifier = Modifier.fillMaxWidth(),
                            colors = formButtonColors
                        ) {
                            Text("Escribir concentración personalizada")
                        }

                        VademecumDropdown(
                            label = "Ciclo",
                            options = ciclos,
                            selectedValue = cicloSeleccionado,
                            expanded = expandedCiclo,
                            onExpandedChange = { expandedCiclo = !expandedCiclo },
                            onDismiss = { expandedCiclo = false },
                            onSelect = {
                                cicloSeleccionado = it
                                expandedCiclo = false
                            },
                            colors = formTextFieldColors
                        )

                        DateSelector(
                            label = "Fecha de inicio",
                            selectedDate = fechaInicio,
                            onPickDate = {
                                calendar.timeInMillis = fechaInicio
                                DatePickerDialog(
                                    context,
                                    { _, year, month, dayOfMonth ->
                                        val picked = Calendar.getInstance().apply {
                                            set(year, month, dayOfMonth, 8, 0, 0)
                                            set(Calendar.MILLISECOND, 0)
                                        }
                                        fechaInicio = picked.timeInMillis
                                        if (fechaFin < fechaInicio) {
                                            fechaFin = fechaInicio
                                        }
                                    },
                                    calendar.get(Calendar.YEAR),
                                    calendar.get(Calendar.MONTH),
                                    calendar.get(Calendar.DAY_OF_MONTH)
                                ).show()
                            },
                            fieldColors = formTextFieldColors,
                            actionColors = formButtonColors
                        )

                        if (esCicloCorto) {
                            DateSelector(
                                label = "Fecha de fin",
                                selectedDate = fechaFin,
                                onPickDate = {
                                    calendar.timeInMillis = fechaFin
                                    DatePickerDialog(
                                        context,
                                        { _, year, month, dayOfMonth ->
                                            val picked = Calendar.getInstance().apply {
                                                set(year, month, dayOfMonth, 8, 0, 0)
                                                set(Calendar.MILLISECOND, 0)
                                            }
                                            fechaFin = picked.timeInMillis
                                        },
                                        calendar.get(Calendar.YEAR),
                                        calendar.get(Calendar.MONTH),
                                        calendar.get(Calendar.DAY_OF_MONTH)
                                    ).show()
                                },
                                fieldColors = formTextFieldColors,
                                actionColors = formButtonColors
                            )
                        }

                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Checkbox(checked = esCicloCorto, onCheckedChange = { esCicloCorto = it })
                            Text("¿Es ciclo corto?")
                        }

                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Checkbox(checked = estaActivo, onCheckedChange = { estaActivo = it })
                            Text("¿Activo?")
                        }

                        TransparentFormSectionCard(modifier = Modifier.fillMaxWidth()) {
                            Row(verticalAlignment = Alignment.CenterVertically) {
                                Checkbox(
                                    checked = controlarExistencias,
                                    onCheckedChange = {
                                        controlarExistencias = it
                                        if (!it) {
                                            stockActualInput = ""
                                            stockMinimoInput = ""
                                        }
                                    }
                                )
                                Text("¿Controlar existencias?")
                            }

                            if (controlarExistencias) {
                                OutlinedTextField(
                                    value = stockActualInput,
                                    onValueChange = { if (it.all(Char::isDigit)) stockActualInput = it },
                                    label = { Text("Stock actual") },
                                    modifier = Modifier.fillMaxWidth(),
                                    singleLine = true,
                                    colors = formTextFieldColors
                                )
                                OutlinedTextField(
                                    value = stockMinimoInput,
                                    onValueChange = { if (it.all(Char::isDigit)) stockMinimoInput = it },
                                    label = { Text("Avisar cuando queden") },
                                    modifier = Modifier.fillMaxWidth(),
                                    singleLine = true,
                                    placeholder = { Text("Ejemplo: 1") },
                                    colors = formTextFieldColors
                                )
                            }
                        }

                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Checkbox(checked = alarmaActiva, onCheckedChange = { alarmaActiva = it })
                            Text("¿Alarma activa?")
                        }

                        if (alarmaActiva) {
                            TransparentFormSectionCard(modifier = Modifier.fillMaxWidth()) {
                                Text("Alerta critica compartida")
                                Text("El sonido y los reintentos se configuran desde el menu hamburguesa para todos los medicamentos.")
                            }
                        }

                        Spacer(modifier = Modifier.height(8.dp))

                        Button(
                            onClick = {
                val activePatient = pacienteActivo
                if (activePatient == null) {
                    abrirNuevaFichaPaciente()
                    Toast.makeText(context, "Primero crea o selecciona un paciente", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (nombre.isBlank()) {
                    Toast.makeText(context, "Introduce un medicamento", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (cantidadInt > 1 && tomaSeleccionada == "En diferentes horarios" && horasTomas.any { it.isBlank() }) {
                    Toast.makeText(context, "Selecciona la hora de cada toma", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (usaHoraUnica && horaTomaSeleccionada.isBlank()) {
                    Toast.makeText(context, "Elige manualmente la hora de la toma", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (controlarExistencias && stockActualInput.isBlank()) {
                    Toast.makeText(context, "Indica el stock actual", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (alarmaActiva && !tienePermisoNotificaciones) {
                    notificationPermissionLauncher.launch(Manifest.permission.POST_NOTIFICATIONS)
                    Toast.makeText(context, "Concede permiso de notificaciones para activar recordatorios", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (alarmaActiva && !tienePermisoAlarmaExacta) {
                    exactAlarmPermissionLauncher.launch(buildExactAlarmPermissionIntent(context))
                    Toast.makeText(context, "Concede permiso de alarmas exactas para programar recordatorios precisos", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                if (alarmaActiva && !tieneAccesoNoMolestar) {
                    notificationPolicyAccessLauncher.launch(buildNotificationPolicyAccessIntent())
                    Toast.makeText(context, "Concede acceso a No molestar para habilitar alertas críticas", Toast.LENGTH_SHORT).show()
                    return@Button
                }

                val duplicate = medicamentosGuardados.firstOrNull { existente ->
                    existente.id != (editingMedicationId ?: 0) && sonMedicamentosDuplicados(
                        existente = existente,
                        nombre = nombre,
                        formato = formatoSeleccionado,
                        concentracion = concentracionSeleccionada
                    )
                }
                if (duplicate != null) {
                    duplicateMedication = duplicate
                    return@Button
                }

                val criticalAlertConfig = CriticalAlertSettings.load(context)
                val stockActual = stockActualInput.toIntOrNull()
                val stockMinimo = stockMinimoInput.toIntOrNull()

                val medication = Medication(
                    id = editingMedicationId ?: 0,
                    patientId = activePatient.id,
                    nombre = nombre,
                    dosis = cantidad.ifBlank { "1" },
                    formato = formatoSeleccionado,
                    presentacion = presentacionPersistida,
                    concentracion = concentracionSeleccionada,
                    repartoDosis = if (cantidadInt > 1) tomaSeleccionada else "En una sola toma",
                    horariosTomas = if (cantidadInt > 1 && tomaSeleccionada == "En diferentes horarios") {
                        horasTomas.joinToString("|")
                    } else {
                        ""
                    },
                    fechaInicio = fechaInicio,
                    fechaFin = if (esCicloCorto) fechaFin else fechaInicio,
                    horaToma = when {
                        cantidadInt > 1 && tomaSeleccionada == "En diferentes horarios" -> horasTomas.firstOrNull().orEmpty()
                        else -> horaTomaSeleccionada
                    },
                    frecuenciaHoras = cicloToHours(cicloSeleccionado),
                    esCicloCorto = esCicloCorto,
                    retryIntervalMinutes = criticalAlertConfig.retryIntervalMinutes,
                    alarmaSonidoUri = criticalAlertConfig.soundUri,
                    alarmaActiva = alarmaActiva,
                    estaActivo = estaActivo,
                    stockActual = if (controlarExistencias) stockActual else null,
                    stockMinimo = if (controlarExistencias) stockMinimo else null
                )
                val isEditing = editingMedicationId != null
                val scheduler = MedicationScheduler(context)

                coroutineScope.launch(Dispatchers.IO) {
                    try {
                        if (!isEditing) {
                            val newId = database.medicationDao().insertar(medication).toInt()
                            scheduler.programarAlarmas(medication.copy(id = newId))
                        } else {
                            database.medicationDao().actualizar(medication)
                            scheduler.programarAlarmas(medication)
                        }

                        withContext(Dispatchers.Main) {
                            resetForm()
                            mostrarFormulario = false
                            Toast.makeText(
                                context,
                                if (isEditing) "Medicamento actualizado" else "Medicamento guardado",
                                Toast.LENGTH_SHORT
                            ).show()
                        }
                    } catch (exception: Exception) {
                        withContext(Dispatchers.Main) {
                            Toast.makeText(
                                context,
                                "No se pudo guardar o programar la alarma: ${exception.message ?: "error desconocido"}",
                                Toast.LENGTH_LONG
                            ).show()
                        }
                    }
                }
            },
                            modifier = Modifier.fillMaxWidth(),
                            colors = formButtonColors
                        ) {
                            Text(if (editingMedicationId == null) "Guardar" else "Guardar cambios")
                        }

                        if (editingMedicationId != null) {
                            Button(
                                onClick = {
                                    resetForm()
                                    cerrarPanelesSecundarios()
                                },
                                modifier = Modifier.fillMaxWidth(),
                                colors = formButtonColors
                            ) {
                                Text("Cancelar edición")
                            }
                        }
                        Button(
                            onClick = {
                                resetForm()
                                cerrarPanelesSecundarios()
                            },
                            modifier = Modifier.fillMaxWidth(),
                            colors = formButtonColors
                        ) {
                            Text("Volver al escritorio")
                        }
                    }
                }
            }

        visorAdjuntos?.let { visor ->
            AttachmentFullscreenViewer(
                visor = visor,
                onDismiss = { visorAdjuntos = null },
                onPrevious = { visorAdjuntos = visor.previous() },
                onNext = { visorAdjuntos = visor.next() }
            )
        }

        if (mostrarDialogoConcentracionPersonalizada) {
            AlertDialog(
                onDismissRequest = { mostrarDialogoConcentracionPersonalizada = false },
                title = { Text("Concentración personalizada") },
                text = {
                    OutlinedTextField(
                        value = concentracionPersonalizadaInput,
                        onValueChange = { concentracionPersonalizadaInput = it },
                        label = { Text("Concentración") },
                        singleLine = true,
                        modifier = Modifier.fillMaxWidth()
                    )
                },
                confirmButton = {
                    Button(
                        onClick = {
                            concentracionSeleccionada = concentracionPersonalizadaInput.trim()
                            mostrarDialogoConcentracionPersonalizada = false
                        }
                    ) {
                        Text("Guardar")
                    }
                },
                dismissButton = {
                    Button(onClick = { mostrarDialogoConcentracionPersonalizada = false }) {
                        Text("Cancelar")
                    }
                }
            )
        }
    }
}

}

@Composable
private fun DateSelector(
    label: String,
    selectedDate: Long,
    onPickDate: () -> Unit,
    fieldColors: TextFieldColors = OutlinedTextFieldDefaults.colors(),
    actionColors: ButtonColors = ButtonDefaults.buttonColors()
) {
    OutlinedTextField(
        value = formatDate(selectedDate),
        onValueChange = {},
        readOnly = true,
        label = { Text(label) },
        modifier = Modifier.fillMaxWidth(),
        trailingIcon = {
            Button(onClick = onPickDate, colors = actionColors) {
                Text("Elegir")
            }
        },
        colors = fieldColors
    )
}

private fun formatDate(timestamp: Long): String {
    return SimpleDateFormat("dd/MM/yyyy", Locale.getDefault()).format(Date(timestamp))
}

private fun formatDateTime(timestamp: Long): String {
    return SimpleDateFormat("dd/MM/yyyy HH:mm", Locale.getDefault()).format(Date(timestamp))
}

private fun formatReminderMinutesLabel(minutes: Int): String {
    return when {
        minutes >= 1440 && minutes % 1440 == 0 -> {
            val days = minutes / 1440
            if (days == 1) "1 dia antes" else "$days dias antes"
        }

        minutes >= 60 && minutes % 60 == 0 -> {
            val hours = minutes / 60
            if (hours == 1) "1 hora antes" else "$hours horas antes"
        }

        minutes == 1 -> "1 minuto antes"
        else -> "$minutes minutos antes"
    }
}

private fun siguienteHoraDisponible(baseTime: Long = System.currentTimeMillis()): Long {
    return Calendar.getInstance().apply {
        timeInMillis = baseTime
        set(Calendar.MINUTE, 0)
        set(Calendar.SECOND, 0)
        set(Calendar.MILLISECOND, 0)
        add(Calendar.HOUR_OF_DAY, 1)
    }.timeInMillis
}

private fun timestampArchivo(timestamp: Long = System.currentTimeMillis()): String {
    return SimpleDateFormat("yyyyMMdd-HHmmss", Locale.getDefault()).format(Date(timestamp))
}

private fun frecuenciaBackupLabel(frequency: String): String {
    return when (frequency) {
        AutoBackupScheduler.FREQUENCY_DAILY -> "Diario"
        AutoBackupScheduler.FREQUENCY_WEEKLY -> "Semanal"
        else -> "Solo manual"
    }
}

private fun calcularEdadDesdeNacimiento(fechaNacimiento: Long, referencia: Long = System.currentTimeMillis()): Int {
    val nacimiento = Calendar.getInstance().apply { timeInMillis = fechaNacimiento }
    val hoy = Calendar.getInstance().apply { timeInMillis = referencia }
    var edad = hoy.get(Calendar.YEAR) - nacimiento.get(Calendar.YEAR)

    if (
        hoy.get(Calendar.MONTH) < nacimiento.get(Calendar.MONTH) ||
        (hoy.get(Calendar.MONTH) == nacimiento.get(Calendar.MONTH) &&
            hoy.get(Calendar.DAY_OF_MONTH) < nacimiento.get(Calendar.DAY_OF_MONTH))
    ) {
        edad -= 1
    }

    return edad.coerceAtLeast(0)
}

private fun formatDashboardDate(timestamp: Long): String {
    return SimpleDateFormat("EEEE, dd 'de' MMMM 'de' yyyy", Locale("es", "ES")).format(Date(timestamp))
}

private fun formatHour(timestamp: Long): String {
    return SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date(timestamp))
}

private fun cicloToHours(ciclo: String): Int {
    return when (ciclo) {
        "Cada 8 horas" -> 8
        "Cada 12 horas" -> 12
        "Diario" -> 24
        "Semanal" -> 24 * 7
        "Mensual" -> 24 * 30
        else -> 0
    }
}

private fun hoursToCycle(hours: Int): String {
    return when (hours) {
        8 -> "Cada 8 horas"
        12 -> "Cada 12 horas"
        24 -> "Diario"
        24 * 7 -> "Semanal"
        24 * 30 -> "Mensual"
        else -> "Personalizado"
    }
}

private fun medicationToVademecum(medication: Medication): VademecumMedication {
    return VademecumMedication(
        nombre = medication.nombre,
        formatos = listOf(medication.formato.ifBlank { "No indicado" }),
        presentaciones = listOf(medication.presentacion.ifBlank { "No indicada" }),
        concentraciones = listOf(medication.concentracion.ifBlank { "No indicada" })
    )
}

private fun sonMedicamentosDuplicados(
    existente: Medication,
    nombre: String,
    formato: String,
    concentracion: String
): Boolean {
    return existente.nombre.trim().equals(nombre.trim(), ignoreCase = true) &&
        existente.formato.trim().equals(formato.trim(), ignoreCase = true) &&
        existente.concentracion.trim().equals(concentracion.trim(), ignoreCase = true)
}

private fun duplicateSignature(medication: Medication): String {
    return listOf(
        medication.nombre.trim().lowercase(Locale.getDefault()),
        medication.formato.trim().lowercase(Locale.getDefault()),
        medication.concentracion.trim().lowercase(Locale.getDefault())
    ).joinToString("|")
}

private fun notificationPermissionGranted(context: Context): Boolean {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
        ContextCompat.checkSelfPermission(
            context,
            Manifest.permission.POST_NOTIFICATIONS
        ) == PackageManager.PERMISSION_GRANTED
    } else {
        true
    }
}

private fun exactAlarmPermissionGranted(context: Context): Boolean {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager
        alarmManager?.canScheduleExactAlarms() ?: true
    } else {
        true
    }
}

private fun notificationPolicyAccessGranted(context: Context): Boolean {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
        val notificationManager = context.getSystemService(Context.NOTIFICATION_SERVICE) as? android.app.NotificationManager
        notificationManager?.isNotificationPolicyAccessGranted ?: true
    } else {
        true
    }
}

private fun buildExactAlarmPermissionIntent(context: Context): Intent {
    val packageUri = Uri.parse("package:${context.packageName}")
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
        Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM, packageUri)
    } else {
        Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, packageUri)
    }
}

private fun buildNotificationPolicyAccessIntent(): Intent {
    return Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)
}

private fun buildRingtonePickerIntent(alarmaSonidoUri: String): Intent {
    val existingUri = when {
        alarmaSonidoUri == NotificacionHelper.SILENT_SOUND_URI -> null
        alarmaSonidoUri.isBlank() -> RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM)
        else -> Uri.parse(alarmaSonidoUri)
    }

    return Intent(RingtoneManager.ACTION_RINGTONE_PICKER).apply {
        putExtra(RingtoneManager.EXTRA_RINGTONE_TYPE, RingtoneManager.TYPE_ALARM)
        putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_DEFAULT, true)
        putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_SILENT, false)
        putExtra(RingtoneManager.EXTRA_RINGTONE_EXISTING_URI, existingUri)
        putExtra(RingtoneManager.EXTRA_RINGTONE_DEFAULT_URI, RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM))
    }
}

private fun resolveAlarmSoundLabel(context: Context, alarmaSonidoUri: String): String {
    return when {
        alarmaSonidoUri == NotificacionHelper.SILENT_SOUND_URI -> "Alarma predeterminada"
        alarmaSonidoUri.isBlank() -> "Alarma predeterminada"
        else -> resolveRingtoneTitle(context, Uri.parse(alarmaSonidoUri))
    }
}

private fun normalizarReintentoCritico(valor: Int): Int {
    return when {
        valor <= 5 -> 5
        valor <= 10 -> 10
        else -> 15
    }
}

private fun resolveRingtoneTitle(context: Context, uri: Uri): String {
    return try {
        RingtoneManager.getRingtone(context, uri)?.getTitle(context)?.takeIf { it.isNotBlank() }
            ?: "Sonido personalizado"
    } catch (_: Exception) {
        "Sonido personalizado"
    }
}

private fun cameraPermissionGranted(context: Context): Boolean {
    return ContextCompat.checkSelfPermission(
        context,
        Manifest.permission.CAMERA
    ) == PackageManager.PERMISSION_GRANTED
}

private fun saveBitmapToInternalStorage(context: Context, bitmap: Bitmap): String? {
    return try {
        val file = File(context.filesDir, "study_${System.currentTimeMillis()}.jpg")
        FileOutputStream(file).use { stream ->
            bitmap.compress(Bitmap.CompressFormat.JPEG, 92, stream)
        }
        Uri.fromFile(file).toString()
    } catch (_: Exception) {
        null
    }
}

private fun copyUriToInternalStorage(context: Context, sourceUri: Uri): String? {
    return try {
        val file = File(context.filesDir, "study_import_${System.currentTimeMillis()}.jpg")
        context.contentResolver.openInputStream(sourceUri)?.use { input ->
            FileOutputStream(file).use { output ->
                input.copyTo(output)
            }
        }
        Uri.fromFile(file).toString()
    } catch (_: Exception) {
        null
    }
}

private fun decodeAttachmentPaths(paths: String): List<String> {
    return paths.split("|").filter { it.isNotBlank() }
}

private fun attachmentDisplayName(path: String, index: Int): String {
    return Uri.parse(path).lastPathSegment ?: "Estudio ${index + 1}"
}

@Composable
private fun AttachmentThumbnail(
    path: String,
    modifier: Modifier = Modifier.size(88.dp),
    onClick: () -> Unit,
    contentScale: ContentScale = ContentScale.Crop,
    targetSize: Int = 512
) {
    val context = LocalContext.current
    val bitmap by produceState<Bitmap?>(initialValue = null, path) {
        value = withContext(Dispatchers.IO) {
            decodeAttachmentBitmap(context, path, targetSize)
        }
    }

    Card(modifier = modifier.clickable(onClick = onClick)) {
        if (bitmap != null) {
            Image(
                bitmap = bitmap!!.asImageBitmap(),
                contentDescription = "Adjunto del informe",
                modifier = Modifier.fillMaxSize(),
                contentScale = contentScale
            )
        } else {
            Column(
                modifier = Modifier.fillMaxSize().padding(8.dp),
                verticalArrangement = Arrangement.Center,
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                Icon(Icons.Default.Description, contentDescription = null)
                Text("Sin vista previa")
            }
        }
    }
}

@Composable
private fun AttachmentFullscreenViewer(
    visor: AttachmentViewerState,
    onDismiss: () -> Unit,
    onPrevious: () -> Unit,
    onNext: () -> Unit
) {
    var scale by remember(visor.currentPath) { mutableFloatStateOf(1f) }
    var offsetX by remember(visor.currentPath) { mutableFloatStateOf(0f) }
    var offsetY by remember(visor.currentPath) { mutableFloatStateOf(0f) }

    Dialog(
        onDismissRequest = onDismiss,
        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false)
    ) {
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(Color.Black)
        ) {
            AttachmentThumbnail(
                path = visor.currentPath,
                modifier = Modifier
                    .fillMaxSize()
                    .padding(vertical = 72.dp, horizontal = 12.dp)
                    .pointerInput(visor.currentPath) {
                        detectTransformGestures { _, pan, zoom, _ ->
                            val nextScale = (scale * zoom).coerceIn(1f, 5f)
                            scale = nextScale
                            if (nextScale <= 1f) {
                                offsetX = 0f
                                offsetY = 0f
                            } else {
                                offsetX += pan.x
                                offsetY += pan.y
                            }
                        }
                    }
                    .graphicsLayer(
                        scaleX = scale,
                        scaleY = scale,
                        translationX = offsetX,
                        translationY = offsetY
                    ),
                onClick = {},
                contentScale = ContentScale.Fit,
                targetSize = 2048
            )

            Column(
                modifier = Modifier
                    .align(Alignment.TopCenter)
                    .fillMaxWidth()
                    .padding(12.dp),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                Text(
                    text = attachmentDisplayName(visor.currentPath, visor.currentIndex),
                    color = Color.White
                )
                Text(
                    text = "${visor.currentIndex + 1} de ${visor.paths.size}",
                    color = Color.White
                )
            }

            Row(
                modifier = Modifier
                    .align(Alignment.BottomCenter)
                    .fillMaxWidth()
                    .padding(12.dp),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                Button(
                    onClick = onPrevious,
                    enabled = visor.canGoPrevious,
                    modifier = Modifier.weight(1f)
                ) {
                    Text("←")
                }
                Button(
                    onClick = {
                        scale = 1f
                        offsetX = 0f
                        offsetY = 0f
                    },
                    modifier = Modifier.weight(1f)
                ) {
                    Text("⤢")
                }
                Button(
                    onClick = onNext,
                    enabled = visor.canGoNext,
                    modifier = Modifier.weight(1f)
                ) {
                    Text("→")
                }
                Button(
                    onClick = onDismiss,
                    modifier = Modifier.weight(1f)
                ) {
                    Text("✕")
                }
            }
        }
    }
}

private fun decodeAttachmentBitmap(context: Context, path: String, targetSize: Int): Bitmap? {
    return try {
        val uri = Uri.parse(path)
        val localPath = when {
            uri.scheme.equals("file", ignoreCase = true) -> uri.path
            uri.scheme.isNullOrBlank() && path.startsWith("/") -> path
            else -> null
        }

        if (!localPath.isNullOrBlank()) {
            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            BitmapFactory.decodeFile(localPath, bounds)
            if (bounds.outWidth <= 0 || bounds.outHeight <= 0) {
                return null
            }

            val options = BitmapFactory.Options().apply {
                inSampleSize = calculateInSampleSize(bounds, targetSize, targetSize)
            }
            return BitmapFactory.decodeFile(localPath, options)
        }

        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
        context.contentResolver.openInputStream(uri)?.use { input ->
            BitmapFactory.decodeStream(input, null, bounds)
        } ?: return null

        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) {
            return null
        }

        val options = BitmapFactory.Options().apply {
            inSampleSize = calculateInSampleSize(bounds, targetSize, targetSize)
        }
        context.contentResolver.openInputStream(uri)?.use { input ->
            BitmapFactory.decodeStream(input, null, options)
        }
    } catch (_: Exception) {
        null
    }
}

private fun calculateInSampleSize(options: BitmapFactory.Options, reqWidth: Int, reqHeight: Int): Int {
    val height = options.outHeight
    val width = options.outWidth
    var inSampleSize = 1

    if (height > reqHeight || width > reqWidth) {
        var halfHeight = height / 2
        var halfWidth = width / 2

        while (halfHeight / inSampleSize >= reqHeight && halfWidth / inSampleSize >= reqWidth) {
            inSampleSize *= 2
        }
    }

    return inSampleSize.coerceAtLeast(1)
}

private data class UpcomingDose(
    val medication: Medication,
    val doseTimeMillis: Long,
    val hora: String
)

private data class MedicationDaySchedule(
    val medication: Medication,
    val tomas: List<UpcomingDose>,
